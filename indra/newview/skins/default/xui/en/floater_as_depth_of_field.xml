<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- AyaneStorm-owned cinematic depth-of-field controls.
     Author: chanayane@firestorm -->
<floater name="as_depth_of_field" title="AyaneStorm Depth of Field"
         positioning="cascading" can_resize="false" can_minimize="true"
         save_rect="true" single_instance="true" layout="topleft"
         width="430" height="539">
  <!-- Toolbar: DoF on/off, then buttons. The animation freeze can also change elsewhere (Ctrl+Alt+N,
       Ctrl+J), so the button only inverts the current state
       (ASDoFRenderer::registerUICallbacks()). No focus lock button: with
       focus following the pointer, clicking it would focus on whatever is
       behind the button (use Alt+Shift+X). -->
  <check_box name="dof_enable" control_name="RenderDepthOfField"
             layout="topleft" left="15" top="11" width="150" height="20"
             label="Enable Depth of Field" />
  <button name="toolbar_animations" label="Toggle animations" layout="topleft"
          left="175" top="10" width="130" height="22"
          tool_tip="Freezes or resumes all animations (same as Ctrl+Alt+N / Ctrl+J). While frozen from here, the sky (sun, moon, stars, clouds) and falling snow are held too.">
    <button.commit_callback function="ASDepthOfField.Toolbar" parameter="animations" />
  </button>
  <button name="toolbar_refresh" enabled_control="ASDepthOfFieldUIAperture" label="Refresh" layout="topleft"
          left="310" top="10" width="95" height="22"
          tool_tip="Restarts accumulating samples (Aperture-sampled renderer).">
    <button.commit_callback function="ASDepthOfField.Toolbar" parameter="refresh" />
  </button>
  <text name="mode_label" layout="topleft" left="15" top="46" width="125" height="18">Renderer</text>
  <combo_box name="dof_mode" control_name="ASDepthOfFieldMode"
             layout="topleft" left="145" top="42" width="235" height="22">
    <combo_box.item label="Standard / Firestorm" name="standard" value="0" />
    <combo_box.item label="Advanced / AyaneStorm" name="advanced" value="1" />
    <combo_box.item label="Aperture-sampled (still images only)" name="aperture" value="2" />
    <combo_box.item label="Live / AyaneStorm (new)" name="live" value="3" />
  </combo_box>
  <button name="reset_dof_mode" label="D" layout="topleft"
          left="385" top="42" width="20" height="22" tool_tip="Reset to default.">
    <button.commit_callback function="ASDepthOfField.ResetDefault" parameter="ASDepthOfFieldMode" />
  </button>

  <!-- Grouped in tabs to keep the floater short. Controls that have no
       effect in the selected renderer are greyed out (enabled_control flags
       synced by ASDoFRenderer::syncModeFlags()). -->
  <tab_container name="dof_tabs" layout="topleft" follows="all"
                 left="0" top="72" width="430" height="424"
                 tab_position="top" halign="center">

    <!-- Focus: all renderers (asdofautofocus.h). -->
    <panel name="focus_tab" label="Focus" layout="topleft" follows="all"
           left="0" top="0" width="430" height="399">
      <text name="focus_mode_label" layout="topleft" left="15" top="14" width="125" height="18">Focus</text>
      <combo_box name="focus_mode" control_name="ASDepthOfFieldFocusMode"
                 layout="topleft" left="145" top="10" width="235" height="22"
                 tool_tip="Focus point: Firestorm behaviour (camera focus, or pointer with 'Focus follows pointer'). Autofocus: the depths inside the autofocus area, nearer surfaces weighing more. Eyes: the near eye of the avatar in the area nearest the camera; with none visible, as Autofocus. Alt+Shift+Z switches between Focus point and the last autofocus mode; Alt+Shift+X locks the focus.">
        <combo_box.item label="Focus point (Firestorm)" name="point" value="0" />
        <combo_box.item label="Autofocus on area" name="area" value="1" />
        <combo_box.item label="Autofocus on eyes" name="eyes" value="2" />
      </combo_box>
      <button name="reset_focus_mode" label="D" layout="topleft"
              left="385" top="10" width="20" height="22" tool_tip="Reset to default.">
        <button.commit_callback function="ASDepthOfField.ResetDefault" parameter="ASDepthOfFieldFocusMode" />
      </button>
      <slider name="autofocus_area" control_name="ASDepthOfFieldAutofocusArea"
              layout="topleft" left="15" top="44" width="365" height="18"
              label="Area size" label_width="130" min_val="0.02" max_val="1"
              increment="0.01" decimal_digits="2" can_edit_text="true"
              tool_tip="Size of the square autofocus area, as a fraction of the view height. Eyes mode only tracks eyes inside it." />
      <button name="reset_autofocus_area" label="D" layout="topleft"
              left="385" top="42" width="20" height="22" tool_tip="Reset to default.">
        <button.commit_callback function="ASDepthOfField.ResetDefault" parameter="ASDepthOfFieldAutofocusArea" />
      </button>
      <slider name="autofocus_x" control_name="ASDepthOfFieldAutofocusX"
              layout="topleft" left="15" top="72" width="365" height="18"
              label="Area horizontal" label_width="130" min_val="0" max_val="1"
              increment="0.01" decimal_digits="2" can_edit_text="true"
              tool_tip="Centre of the autofocus area: 0 left edge, 1 right edge." />
      <button name="reset_autofocus_x" label="D" layout="topleft"
              left="385" top="70" width="20" height="22" tool_tip="Reset to default.">
        <button.commit_callback function="ASDepthOfField.ResetDefault" parameter="ASDepthOfFieldAutofocusX" />
      </button>
      <slider name="autofocus_y" control_name="ASDepthOfFieldAutofocusY"
              layout="topleft" left="15" top="100" width="365" height="18"
              label="Area vertical" label_width="130" min_val="0" max_val="1"
              increment="0.01" decimal_digits="2" can_edit_text="true"
              tool_tip="Centre of the autofocus area: 0 top edge, 1 bottom edge." />
      <button name="reset_autofocus_y" label="D" layout="topleft"
              left="385" top="98" width="20" height="22" tool_tip="Reset to default.">
        <button.commit_callback function="ASDepthOfField.ResetDefault" parameter="ASDepthOfFieldAutofocusY" />
      </button>
      <slider name="autofocus_time" control_name="ASDepthOfFieldAutofocusTime"
              layout="topleft" left="15" top="128" width="365" height="18"
              label="Focus time (s)" label_width="130" min_val="0" max_val="3"
              increment="0.05" decimal_digits="2" can_edit_text="true"
              tool_tip="Seconds to reach a new focus distance; 0 is instant. Small depth changes (breathing, idle animations) are ignored so the image stays still." />
      <button name="reset_autofocus_time" label="D" layout="topleft"
              left="385" top="126" width="20" height="22" tool_tip="Reset to default.">
        <button.commit_callback function="ASDepthOfField.ResetDefault" parameter="ASDepthOfFieldAutofocusTime" />
      </button>
      <slider name="autofocus_near_priority" control_name="ASDepthOfFieldAutofocusNearPriority"
              layout="topleft" left="15" top="156" width="365" height="18"
              label="Near priority" label_width="130" min_val="0" max_val="1"
              increment="0.01" decimal_digits="2" can_edit_text="true"
              tool_tip="0 focuses on the typical depth of the area (weighted median); higher values favour its nearest surfaces." />
      <button name="reset_autofocus_near_priority" label="D" layout="topleft"
              left="385" top="154" width="20" height="22" tool_tip="Reset to default.">
        <button.commit_callback function="ASDepthOfField.ResetDefault" parameter="ASDepthOfFieldAutofocusNearPriority" />
      </button>
      <slider name="autofocus_eye_radius" control_name="ASDepthOfFieldAutofocusEyeRadius"
              layout="topleft" left="15" top="184" width="290" height="18"
              label="Eyeball radius (mm)" label_width="130" min_val="0" max_val="30"
              increment="0.1" decimal_digits="1" can_edit_text="true"
              tool_tip="Eyes mode focuses on the front of the eye, this far from the eye centre. 0 (default) measures mesh eyes automatically; the focus label shows the radius used ('measured', or 'default' 12 mm when the eyes cannot be measured, e.g. system eyes). Set a value to override." />
      <button name="autofocus_redetect_eyes" label="Redetect" layout="topleft"
              left="310" top="182" width="70" height="22"
              tool_tip="Measures the mesh eyes again (each avatar is measured once, the first time it is focused on). Use after changing eyes or head.">
        <button.commit_callback function="ASDepthOfField.RedetectEyes" />
      </button>
      <button name="reset_autofocus_eye_radius" label="D" layout="topleft"
              left="385" top="182" width="20" height="22" tool_tip="Reset to default.">
        <button.commit_callback function="ASDepthOfField.ResetDefault" parameter="ASDepthOfFieldAutofocusEyeRadius" />
      </button>
      <text name="autofocus_lock_label" layout="topleft" left="15" top="214" width="125" height="18">Lock (Alt+Shift+X)</text>
      <combo_box name="autofocus_lock_mode" control_name="ASDepthOfFieldAutofocusLockMode"
                 layout="topleft" left="145" top="210" width="235" height="22"
                 tool_tip="What the focus lock does in autofocus. Freeze distance: the classic lock, the focus stays at its current distance. Track subject: locks what is focused (the tracked eyes, else the surface at the area centre) and keeps it in focus as it or the camera moves; on an avatar it follows the body part, so a mesh face stays sharp.">
        <combo_box.item label="Freeze distance" name="distance" value="0" />
        <combo_box.item label="Track subject" name="subject" value="1" />
      </combo_box>
      <button name="reset_autofocus_lock_mode" label="D" layout="topleft"
              left="385" top="210" width="20" height="22" tool_tip="Reset to default.">
        <button.commit_callback function="ASDepthOfField.ResetDefault" parameter="ASDepthOfFieldAutofocusLockMode" />
      </button>
      <check_box name="autofocus_track_outside" control_name="ASDepthOfFieldAutofocusTrackOutside"
                 layout="topleft" left="15" top="240" width="365" height="20"
                 label="Track the locked subject outside the area"
                 tool_tip="On: the locked subject stays in focus anywhere in the view. Off: the focus holds while the subject is outside the autofocus area and follows it again when it comes back." />
      <button name="reset_autofocus_track_outside" label="D" layout="topleft"
              left="385" top="239" width="20" height="22" tool_tip="Reset to default.">
        <button.commit_callback function="ASDepthOfField.ResetDefault" parameter="ASDepthOfFieldAutofocusTrackOutside" />
      </button>
      <check_box name="autofocus_show_area" control_name="ASDepthOfFieldAutofocusShowArea"
                 layout="topleft" left="15" top="266" width="365" height="20"
                 label="Show autofocus area (Alt+Shift+V)"
                 tool_tip="Outlines the autofocus area (yellow; green on eyes; red when locked, with the subject marked) and shows the focus distance while autofocus is on. Never in snapshots." />
      <button name="reset_autofocus_show_area" label="D" layout="topleft"
              left="385" top="265" width="20" height="22" tool_tip="Reset to default.">
        <button.commit_callback function="ASDepthOfField.ResetDefault" parameter="ASDepthOfFieldAutofocusShowArea" />
      </button>
      <text name="autofocus_note" layout="topleft" left="15" top="294" width="390" height="44" wrap="true"
            text_color="LabelTextColor">Alpha-blended surfaces (some hair, clothing, particles) do not write depth: area autofocus sees what is behind them.</text>
    </panel>

    <!-- Aperture shape: Advanced and Aperture-sampled renderers. -->
    <panel name="aperture_tab" label="Aperture" layout="topleft" follows="all"
           left="0" top="0" width="430" height="399">
      <text name="blades_label" enabled_control="ASDepthOfFieldUIShape" layout="topleft" left="15" top="14" width="125" height="18">Aperture shape</text>
      <combo_box name="aperture_blades" enabled_control="ASDepthOfFieldUIShape" control_name="ASDepthOfFieldApertureBlades"
                 layout="topleft" left="145" top="10" width="235" height="22">
        <combo_box.item label="Circle" name="circle" value="0" />
        <combo_box.item label="Triangle" name="triangle" value="3" />
        <combo_box.item label="Square" name="square" value="4" />
        <combo_box.item label="Pentagon" name="pentagon" value="5" />
        <combo_box.item label="Hexagon" name="hexagon" value="6" />
        <combo_box.item label="Heptagon" name="heptagon" value="7" />
        <combo_box.item label="Octagon" name="octagon" value="8" />
        <combo_box.item label="Nonagon" name="nonagon" value="9" />
      </combo_box>
      <button name="reset_aperture_blades" enabled_control="ASDepthOfFieldUIShape" label="D" layout="topleft"
              left="385" top="10" width="20" height="22" tool_tip="Reset to default.">
        <button.commit_callback function="ASDepthOfField.ResetDefault" parameter="ASDepthOfFieldApertureBlades" />
      </button>
      <slider name="aperture_roundness" enabled_control="ASDepthOfFieldUIShape" control_name="ASDepthOfFieldApertureRoundness"
              layout="topleft" left="15" top="44" width="365" height="18"
              label="Blade rounding" label_width="130" min_val="0" max_val="1"
              increment="0.01" decimal_digits="2" can_edit_text="true"
              tool_tip="0 preserves the selected polygon; 1 rounds it completely back into a circle." />
      <button name="reset_aperture_roundness" enabled_control="ASDepthOfFieldUIShape" label="D" layout="topleft"
              left="385" top="42" width="20" height="22" tool_tip="Reset to default.">
        <button.commit_callback function="ASDepthOfField.ResetDefault" parameter="ASDepthOfFieldApertureRoundness" />
      </button>
      <slider name="aperture_rotation" enabled_control="ASDepthOfFieldUIShape" control_name="ASDepthOfFieldApertureRotation"
              layout="topleft" left="15" top="72" width="365" height="18"
              label="Aperture rotation" label_width="130" min_val="0" max_val="360"
              increment="1" decimal_digits="0" can_edit_text="true" />
      <button name="reset_aperture_rotation" enabled_control="ASDepthOfFieldUIShape" label="D" layout="topleft"
              left="385" top="70" width="20" height="22" tool_tip="Reset to default.">
        <button.commit_callback function="ASDepthOfField.ResetDefault" parameter="ASDepthOfFieldApertureRotation" />
      </button>
      <slider name="anamorphic_ratio" enabled_control="ASDepthOfFieldUIShape" control_name="ASDepthOfFieldAnamorphicRatio"
              layout="topleft" left="15" top="100" width="365" height="18"
              label="Anamorphic ratio" label_width="130" min_val="0.1" max_val="2"
              increment="0.01" decimal_digits="2" can_edit_text="true" />
      <button name="reset_anamorphic_ratio" enabled_control="ASDepthOfFieldUIShape" label="D" layout="topleft"
              left="385" top="98" width="20" height="22" tool_tip="Reset to default.">
        <button.commit_callback function="ASDepthOfField.ResetDefault" parameter="ASDepthOfFieldAnamorphicRatio" />
      </button>
    </panel>

    <!-- Aperture-sampled renderer: sample counts, snapshots, smoothing. -->
    <panel name="sampling_tab" label="Sampling" layout="topleft" follows="all"
           left="0" top="0" width="430" height="399">
      <text name="aperture_note" layout="topleft" left="15" top="8" width="390" height="44" wrap="true"
            text_color="LabelTextColor"
            tool_tip="Used only by the Aperture-sampled renderer.">Aperture-sampled renderer, for perfectly still images. The blur builds up over seconds while nothing moves. Anything that moves (avatars, camera) smears or restarts it.</text>
      <slider name="aperture_samples" enabled_control="ASDepthOfFieldUIAperture" control_name="ASDepthOfFieldApertureSamples"
              layout="topleft" left="15" top="56" width="365" height="18"
              label="Samples per frame" label_width="130" min_val="1" max_val="32"
              increment="1" decimal_digits="0" can_edit_text="true"
              tool_tip="Lens samples added per frame while still. Higher converges sooner but lowers the frame rate while developing." />
      <button name="reset_aperture_samples" enabled_control="ASDepthOfFieldUIAperture" label="D" layout="topleft"
              left="385" top="54" width="20" height="22" tool_tip="Reset to default.">
        <button.commit_callback function="ASDepthOfField.ResetDefault" parameter="ASDepthOfFieldApertureSamples" />
      </button>
      <slider name="aperture_max_samples" enabled_control="ASDepthOfFieldUIAperture" control_name="ASDepthOfFieldApertureMaxSamples"
              layout="topleft" left="15" top="84" width="365" height="18"
              label="Total samples" label_width="130" min_val="16" max_val="4096"
              increment="16" decimal_digits="0" can_edit_text="true"
              tool_tip="Samples in the finished live image. More is smoother but takes longer to develop. Tip: wait for the counter to finish, then take a snapshot at window size to reuse it instantly." />
      <button name="reset_aperture_max_samples" enabled_control="ASDepthOfFieldUIAperture" label="D" layout="topleft"
              left="385" top="82" width="20" height="22" tool_tip="Reset to default.">
        <button.commit_callback function="ASDepthOfField.ResetDefault" parameter="ASDepthOfFieldApertureMaxSamples" />
      </button>
      <slider name="aperture_snapshot_samples" enabled_control="ASDepthOfFieldUIAperture" control_name="ASDepthOfFieldApertureSnapshotSamples"
              layout="topleft" left="15" top="112" width="365" height="18"
              label="Snapshot samples" label_width="130" min_val="16" max_val="4096"
              increment="16" decimal_digits="0" can_edit_text="true"
              tool_tip="Samples rendered for a snapshot. A finished live view with at least this many samples at the same size is reused instantly; otherwise the capture renders them, within the snapshot time limit (Esc stops it early on Windows, keeping what is rendered)." />
      <button name="reset_aperture_snapshot_samples" enabled_control="ASDepthOfFieldUIAperture" label="D" layout="topleft"
              left="385" top="110" width="20" height="22" tool_tip="Reset to default.">
        <button.commit_callback function="ASDepthOfField.ResetDefault" parameter="ASDepthOfFieldApertureSnapshotSamples" />
      </button>
      <slider name="aperture_snapshot_seconds" enabled_control="ASDepthOfFieldUIAperture" control_name="ASDepthOfFieldApertureSnapshotMaxSeconds"
              layout="topleft" left="15" top="140" width="365" height="18"
              label="Snapshot time limit" label_width="130" min_val="5" max_val="600"
              increment="5" decimal_digits="0" can_edit_text="true"
              tool_tip="Maximum seconds a snapshot spends rendering samples; the snapshot keeps the samples rendered so far. The snapshot floater renders in short slices and the viewer keeps running (stay still: moving the camera ends the capture). Other snapshot commands and tiled high-res snapshots block the viewer and are capped at 30 s to avoid being logged out." />
      <button name="reset_aperture_snapshot_seconds" enabled_control="ASDepthOfFieldUIAperture" label="D" layout="topleft"
              left="385" top="138" width="20" height="22" tool_tip="Reset to default.">
        <button.commit_callback function="ASDepthOfField.ResetDefault" parameter="ASDepthOfFieldApertureSnapshotMaxSeconds" />
      </button>
      <slider name="aperture_residual_blur" enabled_control="ASDepthOfFieldUIAperture" control_name="ASDepthOfFieldApertureResidualBlur"
              layout="topleft" left="15" top="168" width="365" height="18"
              label="Dot smoothing" label_width="130" min_val="0" max_val="10"
              increment="0.05" decimal_digits="2" can_edit_text="true"
              tool_tip="Fills the gaps between sample dots in out-of-focus highlights. 1 matches the dot spacing, 2 (default) fills it smoothly; 0 is off. Higher values soften and round the bokeh shape." />
      <button name="reset_aperture_residual_blur" enabled_control="ASDepthOfFieldUIAperture" label="D" layout="topleft"
              left="385" top="166" width="20" height="22" tool_tip="Reset to default.">
        <button.commit_callback function="ASDepthOfField.ResetDefault" parameter="ASDepthOfFieldApertureResidualBlur" />
      </button>
      <slider name="aperture_smoothing" enabled_control="ASDepthOfFieldUIAperture" control_name="ASDepthOfFieldApertureSmoothing"
              layout="topleft" left="15" top="196" width="365" height="18"
              label="Final smoothing" label_width="130" min_val="0" max_val="4"
              increment="0.05" decimal_digits="2" can_edit_text="true"
              tool_tip="Once sampling is finished, smooths only the bokeh shapes of light sources: stars (faint ones included) and glowing objects (bulbs, neon, lamps with glow), located from where the renderer drew them in each sample, over the spacing left between sample dots, so they read as continuous light instead of dots. Everything else, including hair and plain blurred background, stays as sampled. Fades as more samples are rendered. 2 (default) smooths fully; lower keeps crisper bokeh edges; 0 is off." />
      <button name="reset_aperture_smoothing" enabled_control="ASDepthOfFieldUIAperture" label="D" layout="topleft"
              left="385" top="194" width="20" height="22" tool_tip="Reset to default.">
        <button.commit_callback function="ASDepthOfField.ResetDefault" parameter="ASDepthOfFieldApertureSmoothing" />
      </button>
      <!-- Hidden to keep the floater short (debug aid; the setting still works).
      <check_box name="aperture_show_smoothing" enabled_control="ASDepthOfFieldUIAperture" control_name="ASDepthOfFieldApertureShowSmoothing"
                 layout="topleft" left="30" top="222" width="350" height="20"
                 label="Show smoothed area (red)"
                 tool_tip="Tints red the areas the final smoothing changes: the bokeh shapes of small lights found from the samples. Everything not red is exactly as sampled. Not saved between sessions." />
      -->
      <check_box name="aperture_show_progress" enabled_control="ASDepthOfFieldUIAperture" control_name="ASDepthOfFieldApertureShowProgress"
                 layout="topleft" left="15" top="224" width="365" height="20"
                 label="Show sample counter (never in snapshots)" />
      <button name="reset_aperture_show_progress" enabled_control="ASDepthOfFieldUIAperture" label="D" layout="topleft"
              left="385" top="223" width="20" height="22" tool_tip="Reset to default.">
        <button.commit_callback function="ASDepthOfField.ResetDefault" parameter="ASDepthOfFieldApertureShowProgress" />
      </button>
    </panel>

    <!-- Optional lens character. Axial CA, cat's eye and spherical
         aberration: Advanced, Aperture-sampled and Live renderers; bright
         highlights: Aperture-sampled; field curvature: Advanced and Live;
         astigmatism: Advanced. -->
    <panel name="effects_tab" label="Lens effects" layout="topleft" follows="all"
           left="0" top="0" width="430" height="399">
      <check_box name="aperture_axial_ca" enabled_control="ASDepthOfFieldUILens" control_name="ASDepthOfFieldApertureAxialCA"
                 layout="topleft" left="15" top="10" width="365" height="20"
                 label="Axial chromatic aberration"
                 tool_tip="Each wavelength focuses at a slightly different distance, as in a real lens: out-of-focus highlights get coloured rims (one colour in front of the focus, another behind) while sharp areas stay neutral. Aperture-sampled: colour needs more samples to smooth out. Advanced: applied to the opaque scene and light shapes, not to alpha layers such as alpha hair." />
      <button name="reset_aperture_axial_ca" enabled_control="ASDepthOfFieldUILens" label="D" layout="topleft"
              left="385" top="9" width="20" height="22" tool_tip="Reset to default.">
        <button.commit_callback function="ASDepthOfField.ResetDefault" parameter="ASDepthOfFieldApertureAxialCA" />
      </button>
      <slider name="aperture_axial_ca_strength" enabled_control="ASDepthOfFieldUIAxialCA" control_name="ASDepthOfFieldApertureAxialCAStrength"
              layout="topleft" left="15" top="36" width="365" height="18"
              label="Aberration (% of f)" label_width="130" min_val="0" max_val="10"
              increment="0.01" decimal_digits="2" can_edit_text="true"
              tool_tip="Red-to-blue focal shift in percent of the focal length. Real fast lenses are around 0.1-0.2; higher values exaggerate the colour fringes. The fringes grow with the aperture: at small apertures (high f-numbers) only large values show." />
      <button name="reset_aperture_axial_ca_strength" enabled_control="ASDepthOfFieldUIAxialCA" label="D" layout="topleft"
              left="385" top="34" width="20" height="22" tool_tip="Reset to default.">
        <button.commit_callback function="ASDepthOfField.ResetDefault" parameter="ASDepthOfFieldApertureAxialCAStrength" />
      </button>
      <check_box name="aperture_cat_eye" enabled_control="ASDepthOfFieldUILens" control_name="ASDepthOfFieldApertureCatEye"
                 layout="topleft" left="15" top="62" width="365" height="20"
                 label="Cat's-eye bokeh"
                 tool_tip="As in a real lens, the barrel clips the aperture away from the centre of the frame: bokeh toward the edges become lemon-shaped, their long side facing around the centre." />
      <button name="reset_aperture_cat_eye" enabled_control="ASDepthOfFieldUILens" label="D" layout="topleft"
              left="385" top="61" width="20" height="22" tool_tip="Reset to default.">
        <button.commit_callback function="ASDepthOfField.ResetDefault" parameter="ASDepthOfFieldApertureCatEye" />
      </button>
      <slider name="aperture_cat_eye_strength" enabled_control="ASDepthOfFieldUICatEye" control_name="ASDepthOfFieldApertureCatEyeStrength"
              layout="topleft" left="15" top="88" width="365" height="18"
              label="Cat's-eye strength" label_width="130" min_val="0" max_val="2"
