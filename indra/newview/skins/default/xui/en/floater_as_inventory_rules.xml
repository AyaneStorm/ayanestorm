<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!-- AyaneStorm Viewer; author: chanayane@firestorm. Inventory rulesets. -->
<floater
 can_close="true"
 can_resize="true"
 height="420"
 layout="topleft"
 min_height="260"
 min_width="480"
 name="floater_as_inventory_rules"
 positioning="cascading"
 reuse_instance="true"
 save_rect="true"
 single_instance="true"
 title="Inventory Rules"
 width="560">
  <string name="no_items">No rulesets yet. Click New Ruleset to create one.</string>
  <string name="new_ruleset">New ruleset</string>
  <text
   follows="left|right|top"
   height="18"
   layout="topleft"
   left="10"
   name="explanation"
   right="-10"
   top="8"
   word_wrap="true">
    A ruleset is a list of rules that find items or folders and move or delete them.
  </text>
  <flat_list_view
   allow_select="false"
   follows="all"
   item_pad="2"
   layout="topleft"
   left="10"
   name="list"
   right="-10"
   top="30"
   bottom="-84" />
  <button
   follows="left|bottom"
   height="23"
   label="New Ruleset"
   layout="topleft"
   left="10"
   name="new_btn"
   tool_tip="Create a new ruleset"
   top="344"
   width="100" />
  <button
   follows="left|bottom"
   height="23"
   label="Execute All"
   layout="topleft"
   left="118"
   name="execute_all_btn"
   tool_tip="Run every ruleset in list order"
   top="344"
   width="110" />
  <button
   follows="left|bottom"
   height="23"
   label="Stop"
   layout="topleft"
   left="236"
   name="stop_btn"
   tool_tip="Stop after the batch in progress is confirmed"
   top="344"
   width="80" />
  <progress_bar
   follows="left|right|bottom"
   height="10"
   layout="topleft"
   left="10"
   name="progress_bar"
   right="-10"
   top="374" />
  <text
   follows="left|right|bottom"
   height="30"
   layout="topleft"
   left="10"
   name="status_text"
   right="-10"
   top="388"
   word_wrap="true" />
</floater>
