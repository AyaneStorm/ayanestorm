<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- AyaneStorm Viewer; author: chanayane@firestorm. Snow is independent of future Rain/Wind tabs. -->
<panel border="false" follows="all" height="365" layout="topleft" left="1" name="as_weather_snow" top="1" width="454">
  <check_box control_name="ASWeatherSnowEnabled" follows="left|top" height="18"
             label="Snowing" layout="topleft" left="15" mouse_opaque="true"
             name="snow_enabled" radio_style="false" top="18" width="420"
             tool_tip="Render viewer-local world-space snow. Snow remains outdoors through windows and is blocked by roofs and glass." />
  <slider can_edit_text="true" control_name="ASWeatherSnowIntensity" decimal_digits="2"
          enabled_control="ASWeatherSnowEnabled" follows="left|top" height="18" increment="0.05"
          label="Intensity" label_width="170" layout="topleft" left="15" max_val="1.0" min_val="0.0"
          name="snow_intensity" show_text="true" text_width="50" top="58" width="390" />
  <slider can_edit_text="true" control_name="ASWeatherSnowSize" decimal_digits="2"
          enabled_control="ASWeatherSnowEnabled" follows="left|top" height="18" increment="0.05"
          label="Flake size" label_width="170" layout="topleft" left="15" max_val="2.0" min_val="0.1"
          name="snow_size" show_text="true" text_width="50" top="92" width="390" />
  <slider can_edit_text="true" control_name="ASWeatherSnowSpeed" decimal_digits="2"
          enabled_control="ASWeatherSnowEnabled" follows="left|top" height="18" increment="0.05"
          label="Fall speed" label_width="170" layout="topleft" left="15" max_val="2.0" min_val="0.25"
          name="snow_speed" show_text="true" text_width="50" top="126" width="390" />
  <slider can_edit_text="true" control_name="ASWeatherSnowLandedHold" decimal_digits="1"
          enabled_control="ASWeatherSnowEnabled" follows="left|top" height="18" increment="0.5"
          label="Landed hold (seconds)" label_width="170" layout="topleft" left="15" max_val="60.0" min_val="0.0"
          name="snow_landed_hold" show_text="true" text_width="50" top="160" width="390" />
  <slider can_edit_text="true" control_name="ASWeatherSnowLandedFade" decimal_digits="1"
          enabled_control="ASWeatherSnowEnabled" follows="left|top" height="18" increment="0.1"
          label="Landed fade (seconds)" label_width="170" layout="topleft" left="15" max_val="10.0" min_val="0.1"
          name="snow_landed_fade" show_text="true" text_width="50" top="194" width="390" />
  <text follows="left|top" height="16" layout="topleft" left="15" name="snow_quality_label" top="230" width="170">Quality</text>
  <combo_box control_name="ASWeatherSnowQuality" enabled_control="ASWeatherSnowEnabled"
             follows="left|top" height="23" layout="topleft" left="185" name="snow_quality" top="226" width="160">
    <combo_box.item label="Low" name="low" value="0" />
    <combo_box.item label="Medium" name="medium" value="1" />
    <combo_box.item label="High" name="high" value="2" />
  </combo_box>
  <text follows="left|top" height="60" layout="topleft" left="15" name="snow_info" top="270" width="420" wrap="true">
    Snow color follows the current EEP lighting. Flakes rest briefly on terrain and near-horizontal solid surfaces, but not on glass or water.
  </text>
</panel>
