<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel
  border="true"
  follows="all"
  height="480"
  layout="topleft"
  left="1"
  top="1"
  width="540"
  label="AyaneStorm"
  name="ayanestorm">

  <!-- Content is split into sub-tabs because it no longer fits on one page. -->
  <tab_container
    label="AyaneStorm Prefs"
    layout="topleft"
    follows="all"
    top="1"
    bottom="-1"
    left="1"
    right="-1"
    name="ayanestorm_tabs"
    tab_min_width="70"
    tab_position="top">

    <panel
      top_pad="5"
      bottom="-1"
      left="1"
      right="-1"
      follows="all"
      label="General"
      name="tab-as-general">
      <check_box
        follows="left|top"
        layout="topleft"
        height="16"
        control_name="ASEnableUnencryptedCache"
        label="Enable unencrypted cache"
        tool_tip="If checked, the viewer will store an unencrypted copy of assets in the unencrypted cache folder. Be aware that it can quickly take a lot of storage because assets are stored in lossless quality. Disabled by default."
        left="15"
        mouse_opaque="true"
        name="enable_unencrypted_cache"
        radio_style="false"
        width="400"
        top="10">
        <check_box.commit_callback
          function="Pref.EnableUnencryptedCache" />
      </check_box>
      <text
        type="string"
        length="1"
        follows="left|top"
        height="10"
        layout="topleft"
        left="15"
        name="Unencrypted Cache location"
        width="300">
        Unencrypted Cache folder location:
      </text>
      <line_editor
        control_name="ASUnencryptedCacheLocation"
        border_style="line"
        border_thickness="1"
        follows="left|top"
        font="SansSerif"
        height="23"
        layout="topleft"
        left="20"
        max_length_chars="4096"
        name="ASUnencryptedCacheLocation"
        top_pad="10"
        width="270" />
      <button
        enabled="true"
        follows="left|top"
        height="23"
        label="Open"
        label_selected="Open"
        layout="topleft"
        left_pad="5"
        name="open_unencrypted_cache"
        top_delta="-1"
        width="45">
        <button.commit_callback
          function="Pref.BrowseUnencryptedCache" />
      </button>
      <button
        follows="left|top"
        height="23"
        label="Set"
        label_selected="Set"
        layout="topleft"
        left_pad="5"
        name="set_unencrypted_cache"
        top_delta="-0"
        width="40">
        <button.commit_callback
          function="Pref.SetUnencryptedCache" />
      </button>
      <button
        follows="left|top"
        height="23"
        label="Reset"
        label_selected="Reset"
        layout="topleft"
        left_pad="3"
        name="reset_unencrypted_cache"
        top_delta="0"
        width="50">
        <button.commit_callback
          function="Pref.ResetUnencryptedCache" />
      </button>

      <check_box
        follows="left|top"
        layout="topleft"
        height="16"
        control_name="ASShowOwnAvatarInRadar"
        label="Show own avatar in Nearby People radar"
        tool_tip="If checked, your own avatar will appear in the Nearby People radar list."
        left="15"
        mouse_opaque="true"
        name="show_own_avatar_in_radar"
        radio_style="false"
        width="400"
        top_pad="20" />

      <check_box
        follows="left|top"
        layout="topleft"
        height="16"
        control_name="ASSaveFinalSnapshot"
        label="Save final snapshot on exit"
        tool_tip="If checked, the viewer will save a snapshot on exit (original viewer behavior). Disabled by default."
        left="15"
        mouse_opaque="true"
        name="save_final_snapshot"
        radio_style="false"
        width="400"
        top_pad="20" />

      <!-- Advanced Shape Deformer history preference. -->
      <spinner
        control_name="ASBoneDeformerUndoLevels"
        decimal_digits="0"
        follows="left|top"
        height="20"
        increment="1"
        label="Shape Deformer undo levels"
        label_width="220"
        layout="topleft"
        left="15"
        max_val="99"
        min_val="1"
        name="as_bone_deformer_undo_levels"
        top_pad="20"
        width="290"
        tool_tip="Maximum number of Advanced Shape Deformer changes retained for Undo." />
    </panel>

    <panel
      top_pad="5"
      bottom="-1"
      left="1"
      right="-1"
      follows="all"
      label="Rendering"
      name="tab-as-rendering">
      <text
        type="string"
        length="1"
        follows="left|top"
        height="10"
        font="SansSerifSmallBold"
        layout="topleft"
        left="15"
        name="render_oit_mode_label"
        width="300"
        top="10">
        Transparency / OIT
      </text>

      <combo_box
        follows="left|top"
        layout="topleft"
        height="23"
        control_name="ASRenderOITMode"
        tool_tip="Select Standard, AYAstorm unified alpha ordering, lossless Exact OIT, or faster approximate AVBOIT. The selection is applied live."
        left="15"
        name="render_oit_mode"
        width="220"
        top_pad="5">
        <combo_box.item
          label="Standard"
          name="standard"
          value="0" />
        <combo_box.item
          label="Exact-OIT (lossless)"
          name="exact_oit"
          value="1" />
        <combo_box.item
          label="AVBOIT (experimental)"
          name="avboit"
          value="2" />
        <combo_box.item
          label="AYAstorm (mayatonton)"
          name="ayastorm"
          value="3" />
      </combo_box>

      <!-- OIT diagnostic views. -->
      <text
        type="string"
        length="1"
        follows="left|top"
        height="14"
        layout="topleft"
        left="15"
        name="render_exact_oit_debug_label"
        width="225"
        top="65">
        Exact OIT debug mode (0 = off):
      </text>
      <spinner
        control_name="ASRenderExactOITDebugMode"
        enabled_control="ASRenderExactOIT"
        decimal_digits="0"
        follows="left|top"
        increment="1"
        label_width="0"
        left="250"
        max_val="8"
        min_val="0"
        name="render_exact_oit_debug"
        tool_tip="0: final. 1: fragment count. 2: nearest depth. 3: farthest depth. 4: sort validation. 5: blend mode. 6: capacity. 7: opaque-cutoff activity. 8: list-depth buckets."
        top="61"
        width="60" />

      <text
        type="string"
        length="1"
        follows="left|top"
        height="14"
        layout="topleft"
        left="15"
        name="render_avboit_debug_label"
        width="225"
        top="90">
        AVBOIT debug mode (0 = off):
      </text>
      <spinner
        control_name="ASRenderAVBOITDebugMode"
        enabled_control="ASRenderAVBOIT"
        decimal_digits="0"
        follows="left|top"
        increment="1"
        label_width="0"
        left="250"
        max_val="15"
        min_val="0"
        name="render_avboit_debug"
        tool_tip="0: final. 1: active pixels. 2: virtual-depth occupancy. 3: physical-slice utilization. 4: integrated transmittance. 5: effective-zero depth. 6: proxy coverage. 7: depth-warp conformance. 8: integration conformance. 9: aggregate alpha. 10: average transparent color. 11: optical-depth bands. 12: weight bands. 13: volume versus exact transmittance. 14: average front transmittance. 15: selected compaction divider."
        top="86"
        width="60" />

      <view_border
        bevel_style="none"
        border_thickness="1"
        follows="top|left"
        height="0"
        left="15"
        name="rendering_section_divider"
        top="112"
        width="460" />

      <!-- Keep the volumetric master control and links to dedicated rendering settings here. -->
      <check_box
        control_name="RenderVolumetricLighting"
        enabled_control="RenderShadowDetail"
        follows="left|top"
        height="16"
        label="Enable sun/moon god rays"
        layout="topleft"
        left="15"
        mouse_opaque="true"
        name="render_volumetric_lighting"
        radio_style="false"
        tool_tip="If checked, renders raymarched sun/moon light shafts through shadowed geometry. Requires Shadows to be enabled above None in the graphics preferences. Works on macOS."
        top="135"
        width="400" />

      <check_box
        control_name="ASRenderPartialMoonBelowHorizon"
        follows="left|top"
        height="16"
        label="Render partial sun and moon across horizon"
        layout="topleft"
        left="15"
        mouse_opaque="true"
        name="render_partial_celestial_bodies"
        radio_style="false"
        tool_tip="Keeps sun and moon discs visible until their upper edges pass below the horizon. Disable for the original center-based cutoffs. Atmospheric influence remains independent. Changes are applied live."
        top="160"
        width="430" />

      <button
        follows="left|top"
        height="23"
        label="Volumetric lighting settings"
        layout="topleft"
        left="15"
        name="open_volumetric_lighting_settings"
        top="190"
        width="220">
        <button.commit_callback
          function="Floater.ToggleOrBringToFront"
          parameter="as_volumetric_lighting" />
      </button>

      <!-- Viewer-local camera effects controls. -->
      <button
        follows="left|top"
        height="23"
        label="Camera effects settings"
        layout="topleft"
        left="250"
        name="open_camera_effects"
        top="190"
        width="220">
        <button.commit_callback
          function="Floater.ToggleOrBringToFront"
          parameter="as_camera_effects" />
      </button>

      <button
        follows="left|top"
        height="23"
        label="Moon settings"
        layout="topleft"
        left="15"
        name="open_moon_settings"
        top="225"
        width="220">
        <button.commit_callback
          function="Floater.ToggleOrBringToFront"
          parameter="as_moon_settings" />
      </button>
      <button
        follows="left|top"
        height="23"
        label="Sun settings"
        layout="topleft"
        left="250"
        name="open_sun_settings"
        top="225"
        width="220">
        <button.commit_callback
          function="Floater.ToggleOrBringToFront"
          parameter="as_sun_settings" />
      </button>
      <!-- Viewer-local aurora controls. -->
      <button
        follows="left|top"
        height="23"
        label="Aurora settings"
        layout="topleft"
        left="15"
        name="open_aurora_settings"
        top="260"
        width="220">
        <button.commit_callback
          function="Floater.ToggleOrBringToFront"
          parameter="as_aurora_settings" />
      </button>
      <!-- Viewer-local extensible Weather settings. -->
      <button follows="left|top" height="23" label="Weather settings"
              layout="topleft" left="250" name="open_weather_settings"
              top="260" width="220">
        <button.commit_callback function="Floater.ToggleOrBringToFront" parameter="as_weather" />
      </button>
      <!-- Viewer-local analytic horizon-light controls. -->
      <button follows="left|top" height="23" label="Horizon lighting"
              layout="topleft" left="15" name="open_horizon_settings"
              top="295" width="220">
        <button.commit_callback function="Floater.ToggleOrBringToFront" parameter="as_horizon_settings" />
      </button>
      <!-- <AS:Chanayane> Viewer-local photographic color grading. -->
      <button follows="left|top" height="23" label="Color grading"
              layout="topleft" left="250" name="open_color_grading"
              top="295" width="220">
        <button.commit_callback function="Floater.ToggleOrBringToFront" parameter="as_color_grading" />
      </button>
      <!-- </AS:Chanayane> -->
    </panel>

    <!-- <AS:Chanayane> Second rendering tab: room for newer rendering features
         without further crowding the original Rendering tab. -->
    <panel
      top_pad="5"
      bottom="-1"
      left="1"
      right="-1"
      follows="all"
      label="Rendering 2"
      name="tab-as-rendering2">

      <text
        type="string"
        length="1"
        follows="left|top"
        font="SansSerifSmallBold"
        height="14"
        layout="topleft"
        left="15"
        name="motion_blur_section_label"
        width="150"
        top="10">
        Motion blur
      </text>

      <check_box
        control_name="RenderMotionBlur"
        follows="left|top"
        height="16"
        label="Enable camera motion blur"
        layout="topleft"
        left="15"
        mouse_opaque="true"
        name="render_motion_blur"
        radio_style="false"
        tool_tip="Blurs the scene along the camera's motion, reconstructed from scene depth and the previous frame's view. Does not blur independently moving avatars or objects. Changes are applied live."
        top="30"
        width="400" />

      <slider
        can_edit_text="true"
        control_name="RenderMotionBlurStrength"
        enabled_control="RenderMotionBlur"
        decimal_digits="2"
        follows="left|top"
        height="16"
        increment="0.05"
        label="Strength"
        label_width="180"
        layout="topleft"
        left="15"
        max_val="8.0"
        min_val="0.0"
        name="render_motion_blur_strength"
        show_text="true"
        text_width="50"
        tool_tip="Blur intensity multiplier. Zero disables the pass."
        top="57"
        width="390" />
      <button enabled_control="RenderMotionBlur" follows="left|top" height="20" image_overlay="Refresh_Off" layout="topleft" left="415" name="reset_motion_blur_strength" top="55" tool_tip="Reset strength to its default value" width="20"><button.commit_callback function="ASMotionBlur.ResetDefault" parameter="RenderMotionBlurStrength" /></button>

      <slider
        can_edit_text="true"
        control_name="RenderMotionBlurMaxLength"
        enabled_control="RenderMotionBlur"
        decimal_digits="0"
        follows="left|top"
        height="16"
        increment="1"
        label="Max blur length"
        label_width="180"
        layout="topleft"
        left="15"
        max_val="256.0"
        min_val="1.0"
        name="render_motion_blur_max_length"
        show_text="true"
        text_width="50"
        tool_tip="Maximum blur radius in pixels at a 1080-pixel short edge, bounding worst-case streaking during fast camera motion or teleports."
        top="84"
        width="390" />
      <button enabled_control="RenderMotionBlur" follows="left|top" height="20" image_overlay="Refresh_Off" layout="topleft" left="415" name="reset_motion_blur_max_length" top="82" tool_tip="Reset max blur length to its default value" width="20"><button.commit_callback function="ASMotionBlur.ResetDefault" parameter="RenderMotionBlurMaxLength" /></button>

      <text
        type="string"
        length="1"
        follows="left|top"
        height="16"
        layout="topleft"
        left="15"
        name="render_motion_blur_quality_label"
        top="111"
        width="150">
        Quality:
      </text>
      <combo_box
        control_name="RenderMotionBlurQuality"
        enabled_control="RenderMotionBlur"
        follows="left|top"
        height="23"
        layout="topleft"
        left="170"
        mouse_opaque="true"
        name="render_motion_blur_quality"
        tool_tip="Sample count along the blur direction. Higher settings look smoother at a higher GPU cost. Changes are applied live."
        top="108"
        width="215">
        <combo_box.item
          label="Low (8 samples)"
          name="0"
          value="0" />
        <combo_box.item
          label="Medium (16 samples)"
          name="1"
          value="1" />
        <combo_box.item
          label="High (24 samples)"
          name="2"
          value="2" />
      </combo_box>
      <button enabled_control="RenderMotionBlur" follows="left|top" height="20" image_overlay="Refresh_Off" layout="topleft" left="395" name="reset_motion_blur_quality" top="109" tool_tip="Reset quality to its default value" width="20"><button.commit_callback function="ASMotionBlur.ResetDefault" parameter="RenderMotionBlurQuality" /></button>

      <!-- TEMPORARY development aid - remove once the effect is confirmed working end-to-end. -->
      <text
        type="string"
        length="1"
        follows="left|top"
        height="14"
        layout="topleft"
        left="15"
        name="render_motion_blur_debug_label"
        width="150"
        top="140">
        Debug mode:
      </text>
      <spinner
        control_name="RenderMotionBlurDebug"
        enabled_control="RenderMotionBlur"
        decimal_digits="0"
        follows="left|top"
        increment="1"
        label_width="0"
        left="170"
        max_val="3"
        min_val="0"
        name="render_motion_blur_debug"
        tool_tip="0: final. 1: velocity magnitude heatmap (black=0px, red=4px). 2: raw UV delta as signed red/green. 3: matrix-sanity probe, bypasses depth reconstruction; blue tint means the previous-frame reprojection landed behind the camera."
        top="137"
        width="60" />
    </panel>
    <!-- </AS:Chanayane> -->

    <panel
      top_pad="5"
      bottom="-1"
      left="1"
      right="-1"
      follows="all"
      label="Preload"
      name="tab-as-preload">
      <text
        type="string"
        length="1"
        follows="left|top"
        height="10"
        layout="topleft"
        left="15"
        name="preload_dullahan_label"
        width="500"
        top="10">
        Preload Dullahan hosts (accelerates window loading at the cost of dozens of processes):
      </text>
      <check_box
        follows="left|top"
        layout="topleft"
        height="16"
        control_name="ASPreloadDullahanDestinations"
        label="Destinations"
        tool_tip="If checked, the Dullahan (CEF) host for the Destinations floater will be preloaded at startup."
        left="25"
        mouse_opaque="true"
        name="preload_dullahan_destinations"
        radio_style="false"
        width="400"
        top_pad="8" />
      <check_box
        follows="left|top"
        layout="topleft"
        height="16"
        control_name="ASPreloadDullahanAvatarWelcomePack"
        label="Avatar welcome pack"
        tool_tip="If checked, the Dullahan (CEF) host for the Avatar Welcome Pack floater will be preloaded at startup."
        left="25"
        mouse_opaque="true"
        name="preload_dullahan_avatar_welcome_pack"
        radio_style="false"
        width="400"
        top_pad="4" />
      <check_box
        follows="left|top"
        layout="topleft"
        height="16"
        control_name="ASPreloadDullahanSearch"
        label="Search"
        tool_tip="If checked, the Dullahan (CEF) host for the Search floater will be preloaded at startup. Only effective when the FS legacy search mode is active."
        left="25"
        mouse_opaque="true"
        name="preload_dullahan_search"
        radio_style="false"
        width="400"
        top_pad="4" />
      <check_box
        follows="left|top"
        layout="topleft"
        height="16"
        control_name="ASPreloadDullahanLegacySearch"
        label="Legacy search"
        tool_tip="If checked, the Dullahan (CEF) host for the Legacy Search floater will be preloaded at startup. Only effective when the FS legacy search mode is not active."
        left="25"
        mouse_opaque="true"
        name="preload_dullahan_legacy_search"
        radio_style="false"
        width="400"
        top_pad="4" />
      <check_box
        follows="left|top"
        layout="topleft"
        height="16"
        control_name="ASPreloadDullahanMarketplace"
        label="Marketplace"
        tool_tip="If checked, the Dullahan (CEF) host for the Marketplace floater will be preloaded at startup."
        left="25"
        mouse_opaque="true"
        name="preload_dullahan_marketplace"
        radio_style="false"
        width="400"
        top_pad="4" />
    </panel>

    <!-- Audio stream preferences. -->
    <panel
      top_pad="5"
      bottom="-1"
      left="1"
      right="-1"
      follows="all"
      label="Streams"
      name="tab-as-streams">
      <text
        type="string"
        length="1"
        follows="left|top"
        height="10"
        layout="topleft"
        left="15"
        name="as_audio_streams_label"
        width="500"
        top="10">
        Audio streams:
      </text>
      <check_box
        follows="left|top"
        layout="topleft"
        height="16"
        control_name="ASKeepStreamAsk"
        label="Ask before changing the audio stream"
        tool_tip="If checked, when you enter a parcel with a different audio stream or with no stream, the viewer asks whether to keep listening to the current stream. The stream keeps playing while you decide. Disabled by default."
        left="25"
        mouse_opaque="true"
        name="as_keep_stream_ask"
        radio_style="false"
        width="480"
        top_pad="8" />
      <check_box
        follows="left|top"
        layout="topleft"
        height="16"
        control_name="ASAutoPlayDefaultFavorite"
        label="Play my default favorite stream instead of the parcel stream"
        tool_tip="If checked, entering a parcel plays your default favorite stream instead of the parcel's own stream. Set the default from the Favorite Streams floater. Disabled by default."
        left="25"
        mouse_opaque="true"
        name="as_autoplay_default_favorite"
        radio_style="false"
        width="480"
        top_pad="4" />
      <check_box
        follows="left|top"
        layout="topleft"
        height="16"
        control_name="ASShowAddFavoriteStreamButton"
        label="Show the 'add stream to favorites' button in the status bar"
        tool_tip="If checked, a button next to the stream toggle adds the currently playing stream to your favorites."
        left="25"
        mouse_opaque="true"
        name="as_show_add_favorite_stream_button"
        radio_style="false"
        width="480"
        top_pad="4" />
    </panel>

    <panel
      top_pad="5"
      bottom="-1"
      left="1"
      right="-1"
      follows="all"
      label="Conversations"
      name="tab-as-conversations">
      <check_box
        follows="left|top"
        layout="topleft"
        height="16"
        control_name="ASShowConversationTabAvatarThumbnails"
        label="Show avatar thumbnails on conversation tabs"
        tool_tip="If checked, 1:1 avatar conversation tabs show a small profile picture thumbnail. Disabled by default."
        left="15"
        mouse_opaque="true"
        name="as_show_conversation_tab_avatar_thumbnails"
        radio_style="false"
        width="480"
        top="10" />
      <check_box
        follows="left|top"
        layout="topleft"
        height="16"
        control_name="ASShowConversationTabTypingBorder"
        label="Show a yellow border on the thumbnail while the avatar is typing"
        tool_tip="If checked, the avatar thumbnail on a 1:1 conversation tab shows a yellow border while the other person is typing. Requires avatar thumbnails to be enabled. Disabled by default."
        left="15"
        mouse_opaque="true"
        name="as_show_conversation_tab_typing_border"
        radio_style="false"
        width="480"
        top_pad="4" />
      <check_box
        follows="left|top"
        layout="topleft"
        height="16"
        control_name="ASShowTypingTabItalics"
        label="Show conversation tab name in italics when avatar is typing"
        tool_tip="If checked, a 1:1 conversation tab's label is shown in italics while the other person is typing. Disabled by default."
        left="15"
        mouse_opaque="true"
        name="as_show_typing_tab_italics"
        radio_style="false"
        width="480"
        top_pad="4" />
      <!-- Optional Nearby Chat range population counter. -->
      <check_box
        follows="left|top"
        layout="topleft"
        height="16"
        control_name="ASShowNearbyChatRangeCounter"
        label="Show the nearby avatar count on the Nearby Chat toolbar"
        tool_tip="Shows the number of other avatars inside the selected whisper, say, or shout range."
        left="15"
        mouse_opaque="true"
        name="as_show_nearby_chat_range_counter"
        radio_style="false"
        width="480"
        top_pad="10" />
      <!-- Optional friend suffix for the Nearby Chat range counter. -->
      <check_box
        follows="left|top"
        layout="topleft"
        height="16"
        control_name="ASShowNearbyChatRangeFriendCount"
        enabled_control="ASShowNearbyChatRangeCounter"
        label="Append the number of friends in range"
        tool_tip="Displays the friend count in parentheses after the nearby avatar count. Disabled by default."
        left="30"
        mouse_opaque="true"
        name="as_show_nearby_chat_range_friend_count"
        radio_style="false"
        width="465"
        top_pad="4" />
      <check_box
