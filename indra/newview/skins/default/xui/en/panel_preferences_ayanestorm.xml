<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel
  border="true"
  follows="all"
  height="480"
  layout="topleft"
  left="1"
  top="1"
  width="540"
  label="AyaneStorm"
  name="ayanestorm">

  <!-- [AS:Chanayane] Split into sub-tabs, content no longer fits a single page -->
  <tab_container
    label="AyaneStorm Prefs"
    layout="topleft"
    follows="all"
    top="1"
    bottom="-1"
    left="1"
    right="-1"
    name="ayanestorm_tabs"
    tab_min_width="70"
    tab_position="top">

    <panel
      top_pad="5"
      bottom="-1"
      left="1"
      right="-1"
      follows="all"
      label="General"
      name="tab-as-general">

      <check_box
        follows="left|top"
        layout="topleft"
        height="16"
        control_name="ASShowOwnAvatarInRadar"
        label="Show own avatar in Nearby People radar"
        tool_tip="If checked, your own avatar will appear in the Nearby People radar list."
        left="15"
        mouse_opaque="true"
        name="show_own_avatar_in_radar"
        radio_style="false"
        width="400"
        top_pad="20" />

      <check_box
        follows="left|top"
        layout="topleft"
        height="16"
        control_name="ASSaveFinalSnapshot"
        label="Save final snapshot on exit"
        tool_tip="If checked, the viewer will save a snapshot on exit (original viewer behavior). Disabled by default."
        left="15"
        mouse_opaque="true"
        name="save_final_snapshot"
        radio_style="false"
        width="400"
        top_pad="20" />
    </panel>

    <panel
      top_pad="5"
      bottom="-1"
      left="1"
      right="-1"
      follows="all"
      label="Rendering"
      name="tab-as-rendering">
      <text
        type="string"
        length="1"
        follows="left|top"
        height="10"
        font="SansSerifSmallBold"
        layout="topleft"
        left="15"
        name="render_oit_mode_label"
        width="300"
        top="10">
        Transparency / OIT
      </text>

      <combo_box
        follows="left|top"
        layout="topleft"
        height="23"
        control_name="RenderOITMode"
        tool_tip="Select Standard transparency, lossless Exact OIT, or faster approximate AVBOIT. The selection is applied live."
        left="15"
        name="render_oit_mode"
        width="220"
        top_pad="5">
        <combo_box.item
          label="Standard"
          name="standard"
          value="0" />
        <combo_box.item
          label="Exact-OIT (lossless)"
          name="exact_oit"
          value="1" />
        <combo_box.item
          label="AVBOIT (experimental)"
          name="avboit"
          value="2" />
      </combo_box>

      <!-- [AS:Chanayane] OIT diagnostic views -->
      <text
        type="string"
        length="1"
        follows="left|top"
        height="14"
        layout="topleft"
        left="15"
        name="render_exact_oit_debug_label"
        width="225"
        top="65">
        Exact OIT debug mode (0 = off):
      </text>
      <spinner
        control_name="RenderExactOITDebugMode"
        enabled_control="RenderExactOIT"
        decimal_digits="0"
        follows="left|top"
        increment="1"
        label_width="0"
        left="250"
        max_val="9"
        min_val="0"
        name="render_exact_oit_debug"
        tool_tip="0: final. 1: fragment count. 2: nearest depth. 3: farthest depth. 4: sort validation. 5: blend mode. 6: capacity. 7: opaque-cutoff activity. 8: list-depth buckets. 9: compute-sort path."
        top="61"
        width="60" />

      <text
        type="string"
        length="1"
        follows="left|top"
        height="14"
        layout="topleft"
        left="15"
        name="render_avboit_debug_label"
        width="225"
        top="90">
        AVBOIT debug mode (0 = off):
      </text>
      <spinner
        control_name="RenderAVBOITDebugMode"
        enabled_control="RenderAVBOIT"
        decimal_digits="0"
        follows="left|top"
        increment="1"
        label_width="0"
        left="250"
        max_val="15"
        min_val="0"
        name="render_avboit_debug"
        tool_tip="0: final. 1: active pixels. 2: virtual-depth occupancy. 3: physical-slice utilization. 4: integrated transmittance. 5: effective-zero depth. 6: proxy coverage. 7: depth-warp conformance. 8: integration conformance. 9: aggregate alpha. 10: average transparent color. 11: optical-depth bands. 12: weight bands. 13: volume versus exact transmittance. 14: average front transmittance. 15: selected compaction divider."
        top="86"
        width="60" />
      <!-- [/AS:Chanayane] -->

      <view_border
        bevel_style="none"
        border_thickness="1"
        follows="top|left"
        height="0"
        left="15"
        name="rendering_section_divider"
        top="112"
        width="460" />

      <!-- <AS:Chanayane> Keep only the volumetric master control and links to
           the dedicated rendering settings floaters on this preferences tab. -->
      <check_box
        control_name="RenderVolumetricLighting"
        enabled_control="RenderShadowDetail"
        follows="left|top"
        height="16"
        label="Enable sun/moon god rays"
        layout="topleft"
        left="15"
        mouse_opaque="true"
        name="render_volumetric_lighting"
        radio_style="false"
        tool_tip="If checked, renders raymarched sun/moon light shafts through shadowed geometry. Requires Shadows to be enabled above None in the graphics preferences. Works on macOS."
        top="135"
        width="400" />

      <check_box
        control_name="ASRenderPartialMoonBelowHorizon"
        follows="left|top"
        height="16"
        label="Render partial sun and moon across horizon"
        layout="topleft"
        left="15"
        mouse_opaque="true"
        name="render_partial_celestial_bodies"
        radio_style="false"
        tool_tip="Keeps sun and moon discs visible until their upper edges pass below the horizon. Disable for the original center-based cutoffs. Atmospheric influence remains independent. Changes are applied live."
        top="160"
        width="430" />

      <button
        follows="left|top"
        height="23"
        label="Volumetric lighting settings"
        layout="topleft"
        left="15"
        name="open_volumetric_lighting_settings"
        top="190"
        width="220">
        <button.commit_callback
          function="Floater.ToggleOrBringToFront"
          parameter="as_volumetric_lighting" />
      </button>

      <!-- <AS:Chanayane> Dedicated viewer-local camera effects controls. -->
      <button
        follows="left|top"
        height="23"
        label="Camera effects settings"
        layout="topleft"
        left="250"
        name="open_camera_effects"
        top="190"
        width="220">
        <button.commit_callback
          function="Floater.ToggleOrBringToFront"
          parameter="as_camera_effects" />
      </button>
      <!-- </AS:Chanayane> -->

      <button
        follows="left|top"
        height="23"
        label="Moon settings"
        layout="topleft"
        left="15"
        name="open_moon_settings"
        top="225"
        width="220">
        <button.commit_callback
          function="Floater.ToggleOrBringToFront"
          parameter="as_moon_settings" />
      </button>
      <button
        follows="left|top"
        height="23"
        label="Sun settings"
        layout="topleft"
        left="250"
        name="open_sun_settings"
        top="225"
        width="220">
        <button.commit_callback
          function="Floater.ToggleOrBringToFront"
          parameter="as_sun_settings" />
      </button>
      <!-- <AS:Chanayane> Dedicated viewer-local aurora controls. -->
      <button
        follows="left|top"
        height="23"
        label="Aurora settings"
        layout="topleft"
        left="15"
        name="open_aurora_settings"
        top="260"
        width="220">
        <button.commit_callback
          function="Floater.ToggleOrBringToFront"
          parameter="as_aurora_settings" />
      </button>
      <!-- Viewer-local extensible Weather settings. -->
      <button follows="left|top" height="23" label="Weather settings"
              layout="topleft" left="250" name="open_weather_settings"
              top="260" width="220">
        <button.commit_callback function="Floater.ToggleOrBringToFront" parameter="as_weather" />
      </button>
      <!-- </AS:Chanayane> -->
      <!-- </AS:Chanayane> -->
    </panel>

    <!-- <AS:Chanayane> Legacy duplicate retained only as commented reference. -->
    <!-- The former Rendering 2 controls live in the dedicated Moon Settings
         floater. Keep the old markup out of the tab container.
    <panel
      top_pad="5"
      bottom="-1"
      left="1"
      right="-1"
      follows="all"
      label="Rendering 2"
      name="tab-as-rendering-2"
      visible="false">
      <text
        type="string"
        length="1"
        follows="left|top"
        font="SansSerifSmallBold"
        height="14"
        layout="topleft"
        left="15"
        name="render_sky_section_label"
        width="300"
        top="10">
        Sky rendering
      </text>

      <slider
        can_edit_text="true"
        control_name="ASMoonHorizonMinOpacity"
        decimal_digits="2"
        follows="left|top"
        height="16"
        increment="0.05"
        label="Moon visibility at horizon"
        label_width="180"
        layout="topleft"
        left="15"
        max_val="1.0"
        min_val="0.0"
        name="moon_horizon_min_opacity"
        show_text="true"
        text_width="50"
        tool_tip="Minimum opacity of the moon disc at the horizon. 0.00 reproduces the legacy fade; 1.00 disables horizon dimming. Changes are applied live."
        top="34"
        width="380" />

      <slider
        can_edit_text="true"
        control_name="ASMoonBrightnessMultiplier"
        decimal_digits="2"
        follows="left|top"
        height="16"
        increment="0.05"
        label="Moon brightness multiplier"
        label_width="180"
        layout="topleft"
        left="15"
        max_val="5.0"
        min_val="0.0"
        name="moon_brightness_multiplier"
        show_text="true"
        text_width="50"
        tool_tip="Multiplies the current environment's moon-disc brightness without modifying the environment asset. 1.00 preserves its original brightness. Changes are applied live."
        top="60"
        width="380" />

      <slider
        can_edit_text="true"
        control_name="ASMoonPhase"
        decimal_digits="2"
        follows="left|top"
        height="16"
        increment="0.01"
        label="Moon phase"
        label_width="180"
        layout="topleft"
        left="15"
        max_val="1.0"
        min_val="0.0"
        name="moon_phase"
        show_text="true"
        text_width="50"
        tool_tip="Viewer-local moon phase: 0.00 New, 0.25 First quarter, 0.50 Full, 0.75 Last quarter, 1.00 New. The illuminated fraction also scales moon god rays. Changes are applied live."
        top="86"
        width="380" />

      <slider
        can_edit_text="true"
        control_name="ASMoonPhaseCurvature"
        decimal_digits="2"
        follows="left|top"
        height="16"
        increment="0.05"
        label="Moon phase curvature"
        label_width="180"
        layout="topleft"
        left="15"
        max_val="5.0"
        min_val="0.25"
        name="moon_phase_curvature"
        show_text="true"
        text_width="50"
        tool_tip="Nonlinearly reshapes the moon terminator. 1.00 is spherical; higher and lower values provide artistic curve control. Quarter, full, and new moons remain exact. Changes are applied live."
        top="112"
        width="380" />

      <slider
        can_edit_text="true"
        control_name="ASMoonPhaseSoftness"
        decimal_digits="3"
        follows="left|top"
        height="16"
        increment="0.005"
        label="Moon phase softness"
        label_width="180"
        layout="topleft"
        left="15"
        max_val="0.30"
        min_val="0.0"
        name="moon_phase_softness"
        show_text="true"
        text_width="50"
        tool_tip="Width of the nonlinear transition centered on the geometric phase boundary. 0.000 keeps only pixel antialiasing. Changes are applied live."
        top="138"
        width="380" />

      <slider
        can_edit_text="true"
        control_name="ASMoonPhaseTilt"
        decimal_digits="0"
        follows="left|top"
        height="16"
        increment="1.0"
        label="Moon phase tilt (degrees)"
        label_width="180"
        layout="topleft"
        left="15"
        max_val="180.0"
        min_val="-180.0"
        name="moon_phase_tilt"
        show_text="true"
        text_width="50"
        tool_tip="Rotates the crescent and phase terminator around the moon disc. Positive angles rotate counterclockwise; 0 preserves the vertical terminator. Changes are applied live."
        top="164"
        width="380" />

      <slider
        can_edit_text="true" control_name="ASMoonTerminatorReliefStrength"
        decimal_digits="2" follows="left|top" height="16" increment="0.05"
        label="Moon terminator relief" label_width="180" layout="topleft" left="15"
        max_val="2.0" min_val="0.0" name="moon_terminator_relief_strength" show_text="true"
        text_width="50" top="190" width="380"
        tool_tip="Directional crater-detail contrast near the phase boundary. 0.00 disables it. Changes are applied live." />

      <slider
        can_edit_text="true" control_name="ASMoonTerminatorReliefWidth"
        decimal_digits="2" follows="left|top" height="16" increment="0.01"
        label="Terminator relief width" label_width="180" layout="topleft" left="15"
        max_val="0.50" min_val="0.01" name="moon_terminator_relief_width" show_text="true"
        text_width="50" top="216" width="380"
        tool_tip="Width of the enhanced crater-detail band around the phase boundary. Changes are applied live." />

      <slider
        can_edit_text="true" control_name="ASMoonEarthshineStrength"
        decimal_digits="2" follows="left|top" height="16" increment="0.01"
        label="Moon earthshine" label_width="180" layout="topleft" left="15"
        max_val="0.30" min_val="0.00" name="moon_earthshine_strength" show_text="true"
        text_width="50" top="242" width="380"
        tool_tip="Minimum moon texture visibility blended over the sky on the shadowed side. 0.00 fully reveals the sky. It does not contribute to halo or god rays. Changes are applied live." />

      <text
        type="string"
        length="1"
        follows="left|top"
        height="16"
        layout="topleft"
        left="15"
        name="moon_horizon_tint_label"
        top="272"
        width="180">
        Moon horizon color
      </text>

      <color_swatch
        border_color="0.45098, 0.517647, 0.607843, 1"
        can_apply_immediately="true"
        color="1.0, 0.40, 0.0, 1.0"
        control_name="ASMoonHorizonTint"
        follows="left|top"
        height="24"
        label=""
        label_height="0"
        layout="topleft"
        left="200"
        mouse_opaque="true"
        name="moon_horizon_tint"
        tool_tip="Color multiplied into the moon disc near the horizon. Changes are applied live."
        top="268"
        width="44" />

      <slider
        can_edit_text="true"
        control_name="ASMoonHorizonTintStrength"
        decimal_digits="2"
        follows="left|top"
        height="16"
        increment="0.05"
        label="Moon horizon color strength"
        label_width="180"
        layout="topleft"
        left="15"
        max_val="1.0"
        min_val="0.0"
        name="moon_horizon_tint_strength"
        show_text="true"
        text_width="50"
        tool_tip="Strength of the warm moon tint at the horizon. 0.00 disables the effect; the tint smoothly disappears as the moon rises. Changes are applied live."
        top="302"
        width="380" />

      <check_box
        control_name="ASRenderPartialMoonBelowHorizon"
        follows="left|top"
        height="16"
        label="Render partial sun and moon across horizon"
        layout="topleft"
        left="15"
        mouse_opaque="true"
        name="render_partial_moon_below_horizon"
        radio_style="false"
        tool_tip="Keeps rendering sun and moon discs until their upper edges pass below the horizon. Disable for the original center-based cutoffs. Atmospheric influence remains independent. Changes are applied live."
        top="330"
        width="430" />

      <check_box
        control_name="ASMoonHaloEnabled" follows="left|top" height="16"
        label="Enable moon halo" layout="topleft" left="15" mouse_opaque="true"
        name="moon_halo_enabled" radio_style="false" top="356" width="430"
        tool_tip="Render the viewer-local atmospheric halo around the moon. Changes are applied live." />
      <slider
        can_edit_text="true" control_name="ASMoonHaloStrength"
        decimal_digits="2" follows="left|top" height="16" increment="0.05"
        label="Moon halo strength" label_width="180" layout="topleft" left="15"
        max_val="2.0" min_val="0.0" name="moon_halo_strength" show_text="true"
        text_width="50" top="382" width="380"
        tool_tip="Strength of the circular, phase-attenuated atmospheric halo. Moon brightness also scales it through a calibrated saturating response. Changes are applied live." />
      <slider
        can_edit_text="true" control_name="ASMoonHaloRadius"
        decimal_digits="2" follows="left|top" height="16" increment="0.10"
        label="Moon halo radius" label_width="180" layout="topleft" left="15"
        max_val="4.0" min_val="1.25" name="moon_halo_radius" show_text="true"
        text_width="50" top="408" width="380"
        tool_tip="Outer halo radius measured in moon-disc radii. Changes are applied live." />
      <slider
        can_edit_text="true" control_name="ASMoonHaloSoftness"
        decimal_digits="2" follows="left|top" height="16" increment="0.05"
        label="Moon halo softness" label_width="180" layout="topleft" left="15"
        max_val="2.0" min_val="0.10" name="moon_halo_softness" show_text="true"
        text_width="50" top="434" width="380"
        tool_tip="Width of the halo's radial falloff in moon-disc radii. Changes are applied live." />
    </panel>
    -->
    <!-- </AS:Chanayane> -->

    <panel
      top_pad="5"
      bottom="-1"
      left="1"
      right="-1"
      follows="all"
      label="Preload"
      name="tab-as-preload">
      <text
        type="string"
        length="1"
        follows="left|top"
        height="10"
        layout="topleft"
        left="15"
        name="preload_dullahan_label"
        width="500"
        top="10">
        Preload Dullahan hosts (accelerates window loading at the cost of dozens of processes):
      </text>
      <check_box
        follows="left|top"
        layout="topleft"
        height="16"
        control_name="ASPreloadDullahanDestinations"
        label="Destinations"
        tool_tip="If checked, the Dullahan (CEF) host for the Destinations floater will be preloaded at startup."
        left="25"
        mouse_opaque="true"
        name="preload_dullahan_destinations"
        radio_style="false"
        width="400"
        top_pad="8" />
      <check_box
        follows="left|top"
        layout="topleft"
        height="16"
        control_name="ASPreloadDullahanAvatarWelcomePack"
        label="Avatar welcome pack"
        tool_tip="If checked, the Dullahan (CEF) host for the Avatar Welcome Pack floater will be preloaded at startup."
        left="25"
        mouse_opaque="true"
        name="preload_dullahan_avatar_welcome_pack"
        radio_style="false"
        width="400"
        top_pad="4" />
      <check_box
        follows="left|top"
        layout="topleft"
        height="16"
        control_name="ASPreloadDullahanSearch"
        label="Search"
        tool_tip="If checked, the Dullahan (CEF) host for the Search floater will be preloaded at startup. Only effective when the FS legacy search mode is active."
        left="25"
        mouse_opaque="true"
        name="preload_dullahan_search"
        radio_style="false"
        width="400"
        top_pad="4" />
      <check_box
        follows="left|top"
        layout="topleft"
        height="16"
        control_name="ASPreloadDullahanLegacySearch"
        label="Legacy search"
        tool_tip="If checked, the Dullahan (CEF) host for the Legacy Search floater will be preloaded at startup. Only effective when the FS legacy search mode is not active."
        left="25"
        mouse_opaque="true"
        name="preload_dullahan_legacy_search"
        radio_style="false"
        width="400"
        top_pad="4" />
      <check_box
        follows="left|top"
        layout="topleft"
        height="16"
        control_name="ASPreloadDullahanMarketplace"
        label="Marketplace"
        tool_tip="If checked, the Dullahan (CEF) host for the Marketplace floater will be preloaded at startup."
        left="25"
        mouse_opaque="true"
        name="preload_dullahan_marketplace"
        radio_style="false"
        width="400"
        top_pad="4" />
    </panel>

    <!-- <AS:chanayane> Stream keeper -->
    <panel
      top_pad="5"
      bottom="-1"
      left="1"
      right="-1"
      follows="all"
      label="Streams"
      name="tab-as-streams">
      <text
        type="string"
        length="1"
        follows="left|top"
        height="10"
        layout="topleft"
        left="15"
        name="as_audio_streams_label"
        width="500"
        top="10">
        Audio streams:
      </text>
      <check_box
        follows="left|top"
        layout="topleft"
        height="16"
        control_name="ASKeepStreamAsk"
        label="Ask before changing the audio stream"
        tool_tip="If checked, when you enter a parcel with a different audio stream or with no stream, the viewer asks whether to keep listening to the current stream. The stream keeps playing while you decide. Disabled by default."
        left="25"
        mouse_opaque="true"
        name="as_keep_stream_ask"
        radio_style="false"
        width="480"
        top_pad="8" />
      <check_box
        follows="left|top"
        layout="topleft"
        height="16"
        control_name="ASAutoPlayDefaultFavorite"
        label="Play my default favorite stream instead of the parcel stream"
        tool_tip="If checked, entering a parcel plays your default favorite stream instead of the parcel's own stream. Set the default from the Favorite Streams floater. Disabled by default."
        left="25"
        mouse_opaque="true"
        name="as_autoplay_default_favorite"
        radio_style="false"
        width="480"
        top_pad="4" />
      <check_box
        follows="left|top"
        layout="topleft"
        height="16"
        control_name="ASShowAddFavoriteStreamButton"
        label="Show the 'add stream to favorites' button in the status bar"
        tool_tip="If checked, a button next to the stream toggle adds the currently playing stream to your favorites."
        left="25"
        mouse_opaque="true"
        name="as_show_add_favorite_stream_button"
        radio_style="false"
        width="480"
        top_pad="4" />
    </panel>
    <!-- </AS:chanayane> -->

    <panel
      top_pad="5"
      bottom="-1"
      left="1"
      right="-1"
      follows="all"
      label="Conversations"
      name="tab-as-conversations">
      <check_box
        follows="left|top"
        layout="topleft"
        height="16"
        control_name="ASShowConversationTabAvatarThumbnails"
        label="Show avatar thumbnails on conversation tabs"
        tool_tip="If checked, 1:1 avatar conversation tabs show a small profile picture thumbnail. Disabled by default."
        left="15"
        mouse_opaque="true"
        name="as_show_conversation_tab_avatar_thumbnails"
        radio_style="false"
        width="480"
        top="10" />
      <!-- [AS:Chanayane] -->
      <check_box
        follows="left|top"
        layout="topleft"
        height="16"
        control_name="ASShowConversationTabTypingBorder"
        label="Show a yellow border on the thumbnail while the avatar is typing"
        tool_tip="If checked, the avatar thumbnail on a 1:1 conversation tab shows a yellow border while the other person is typing. Requires avatar thumbnails to be enabled. Disabled by default."
        left="15"
        mouse_opaque="true"
        name="as_show_conversation_tab_typing_border"
        radio_style="false"
        width="480"
        top_pad="4" />
      <!-- [/AS:Chanayane] -->
