        <combo_box.item label="McMurdo Station, Antarctica (77.8 S)" name="mcmurdo_station" value="-77.85" />
        <combo_box.item label="Mexico City, Mexico (19.4 N)" name="mexico_city" value="19.43" />
        <combo_box.item label="Moscow, Russia (55.8 N)" name="moscow" value="55.76" />
