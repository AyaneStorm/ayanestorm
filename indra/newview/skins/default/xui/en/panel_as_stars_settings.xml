      </combo_box>
      <slider can_edit_text="true" control_name="ASStarsLatitude" decimal_digits="3" enabled_control="ASStarsRealSkyUI" follows="left|top" height="16" increment="0.001" label="Latitude" label_width="190" layout="topleft" left="15" max_val="90.0" min_val="-90.0" name="stars_latitude" show_text="true" text_width="60" top="40" width="390" tool_tip="Observer latitude in degrees (north positive). 45 suits most of Europe and North America; the pole star sits this high above the north horizon. Greyed out in Procedural mode: real-sky settings only apply to catalogue stars." />
      <button enabled_control="ASStarsRealSkyUI" follows="left|top" height="20" image_overlay="Refresh_Off" layout="topleft" left="415" name="reset_stars_latitude" top="38" tool_tip="Reset latitude to its default value" width="20"><button.commit_callback function="ASStars.ResetDefault" parameter="ASStarsLatitude" /></button>
      <slider can_edit_text="true" control_name="ASStarsSiderealOffset" decimal_digits="3" enabled_control="ASStarsRealSkyUI" follows="left|top" height="16" increment="0.001" label="Sidereal time offset" label_width="190" layout="topleft" left="15" max_val="24.0" min_val="0.0" name="stars_sidereal_offset" show_text="true" text_width="60" top="68" width="390" tool_tip="Hours added to the free-running sky rotation; picks which constellations are up. Greyed out in Procedural mode: real-sky settings only apply to catalogue stars." />
      <button enabled_control="ASStarsRealSkyUI" follows="left|top" height="20" image_overlay="Refresh_Off" layout="topleft" left="415" name="reset_stars_sidereal_offset" top="66" tool_tip="Reset sidereal time offset to its default value" width="20"><button.commit_callback function="ASStars.ResetDefault" parameter="ASStarsSiderealOffset" /></button>
      <slider can_edit_text="true" control_name="ASStarsMagnitudeContrast" decimal_digits="3" enabled_control="ASStarsRealSkyUI" follows="left|top" height="16" increment="0.001" label="Magnitude contrast" label_width="190" layout="topleft" left="15" max_val="1.0" min_val="0.1" name="stars_magnitude_contrast" show_text="true" text_width="60" top="96" width="390" tool_tip="How much brighter bright stars look than faint ones; 1 is physical (brightest stars bigger, faint ones dimmer); lower values even them out. In Procedural mode use Brightness contrast instead. Greyed out in Procedural mode: real-sky settings only apply to catalogue stars." />
      <button enabled_control="ASStarsRealSkyUI" follows="left|top" height="20" image_overlay="Refresh_Off" layout="topleft" left="415" name="reset_stars_magnitude_contrast" top="94" tool_tip="Reset magnitude contrast to its default value" width="20"><button.commit_callback function="ASStars.ResetDefault" parameter="ASStarsMagnitudeContrast" /></button>
      <slider can_edit_text="true" control_name="ASStarsFaintLevel" decimal_digits="3" enabled_control="ASStarsRealSkyUI" follows="left|top" height="16" increment="0.001" label="Faint star brightness" label_width="190" layout="topleft" left="15" max_val="2.0" min_val="0.05" name="stars_faint_level" show_text="true" text_width="60" top="124" width="390" tool_tip="Brightness of the faintest drawn stars; 1 is about white on screen. Lower values turn faint stars into dim points so bright stars and constellations stand out. Greyed out in Procedural mode: real-sky settings only apply to catalogue stars." />
      <button enabled_control="ASStarsRealSkyUI" follows="left|top" height="20" image_overlay="Refresh_Off" layout="topleft" left="415" name="reset_stars_faint_level" top="122" tool_tip="Reset faint star brightness to its default value" width="20"><button.commit_callback function="ASStars.ResetDefault" parameter="ASStarsFaintLevel" /></button>
    </panel>
    <panel border="false" follows="all" height="152" label="Milky Way" layout="topleft" left="0" name="stars_tab_milky_way" top="0" width="456">
      <check_box control_name="ASMilkyWayEnabled" enabled_control="ASStarsRealSkyUI" follows="left|top" height="16" label="Milky Way and deep-sky glow" layout="topleft" left="15" name="milky_way_enabled" top="12" width="410" tool_tip="Draws the Milky Way band, the Magellanic Clouds, Andromeda and bright nebulae from real sky data, fading by day and toward the horizon. Greyed out in Procedural mode: the glow is mapped from real sky data and turns with the catalogue stars." />
      <slider can_edit_text="true" control_name="ASMilkyWayIntensity" decimal_digits="3" enabled_control="ASStarsRealSkyUI" follows="left|top" height="16" increment="0.001" label="Milky Way intensity" label_width="190" layout="topleft" left="15" max_val="4.0" min_val="0.0" name="milky_way_intensity" show_text="true" text_width="60" top="40" width="390" tool_tip="Brightness of the Milky Way band. Greyed out in Procedural mode: the glow is mapped from real sky data and turns with the catalogue stars." />
      <button enabled_control="ASStarsRealSkyUI" follows="left|top" height="20" image_overlay="Refresh_Off" layout="topleft" left="415" name="reset_milky_way_intensity" top="38" tool_tip="Reset milky way intensity to its default value" width="20"><button.commit_callback function="ASStars.ResetDefault" parameter="ASMilkyWayIntensity" /></button>
      <slider can_edit_text="true" control_name="ASMilkyWayDeepSkyIntensity" decimal_digits="3" enabled_control="ASStarsRealSkyUI" follows="left|top" height="16" increment="0.001" label="Deep-sky intensity" label_width="190" layout="topleft" left="15" max_val="4.0" min_val="0.0" name="milky_way_deep_sky" show_text="true" text_width="60" top="68" width="390" tool_tip="Brightness of the Magellanic Clouds, galaxies, nebulae and cluster haze. Greyed out in Procedural mode: the glow is mapped from real sky data and turns with the catalogue stars." />
      <button enabled_control="ASStarsRealSkyUI" follows="left|top" height="20" image_overlay="Refresh_Off" layout="topleft" left="415" name="reset_milky_way_deep_sky" top="66" tool_tip="Reset deep-sky intensity to its default value" width="20"><button.commit_callback function="ASStars.ResetDefault" parameter="ASMilkyWayDeepSkyIntensity" /></button>
      <slider can_edit_text="true" control_name="ASMilkyWaySaturation" decimal_digits="3" enabled_control="ASStarsRealSkyUI" follows="left|top" height="16" increment="0.001" label="Glow saturation" label_width="190" layout="topleft" left="15" max_val="3.0" min_val="0.0" name="milky_way_saturation" show_text="true" text_width="60" top="96" width="390" tool_tip="Color saturation of the glow: warm core, cool outer band, pink nebulae. Greyed out in Procedural mode: the glow is mapped from real sky data and turns with the catalogue stars." />
      <button enabled_control="ASStarsRealSkyUI" follows="left|top" height="20" image_overlay="Refresh_Off" layout="topleft" left="415" name="reset_milky_way_saturation" top="94" tool_tip="Reset glow saturation to its default value" width="20"><button.commit_callback function="ASStars.ResetDefault" parameter="ASMilkyWaySaturation" /></button>
    </panel>
    <panel border="false" follows="all" height="152" label="Procedural" layout="topleft" left="0" name="stars_tab_procedural" top="0" width="456">
      <slider can_edit_text="true" control_name="ASStarsBrightnessVariation" decimal_digits="3" follows="left|top" height="16" increment="0.001" label="Brightness contrast" label_width="190" enabled_control="ASStarsProceduralUI" layout="topleft" left="15" max_val="1.0" min_val="0.0" name="stars_brightness_variation" show_text="true" text_width="60" top="12" width="390" tool_tip="Procedural only. 0 draws every star equally bright (stock); higher values make most stars faint and a few bright, like the real sky. In Real sky mode use Magnitude contrast instead. Greyed out in Real sky mode, where star brightness and positions come from the catalogue." />
      <button follows="left|top" height="20" image_overlay="Refresh_Off" enabled_control="ASStarsProceduralUI" layout="topleft" left="415" name="reset_stars_brightness_variation" top="10" tool_tip="Reset brightness contrast to its default value" width="20"><button.commit_callback function="ASStars.ResetDefault" parameter="ASStarsBrightnessVariation" /></button>
      <slider can_edit_text="true" control_name="ASStarsMilkyWay" decimal_digits="3" follows="left|top" height="16" increment="0.001" label="Milky Way concentration" label_width="190" enabled_control="ASStarsProceduralUI" layout="topleft" left="15" max_val="1.0" min_val="0.0" name="stars_milky_way" show_text="true" text_width="60" top="40" width="390" tool_tip="Procedural only. Adds extra stars in a band across the sky; the background field keeps its density. Greyed out in Real sky mode, where star brightness and positions come from the catalogue." />
      <button follows="left|top" height="20" image_overlay="Refresh_Off" enabled_control="ASStarsProceduralUI" layout="topleft" left="415" name="reset_stars_milky_way" top="38" tool_tip="Reset Milky Way concentration to its default value" width="20"><button.commit_callback function="ASStars.ResetDefault" parameter="ASStarsMilkyWay" /></button>
      <text follows="left|top" height="16" layout="topleft" left="15" name="stars_seed_label" top="76" width="120">Pattern seed</text>
      <spinner control_name="ASStarsSeed" decimal_digits="0" follows="left|top" height="23" increment="1" label_width="0" enabled_control="ASStarsProceduralUI" layout="topleft" left="135" max_val="999999" min_val="0" name="stars_seed" top="68" width="100" tool_tip="Procedural only. 0 picks a new random sky each time stars are built; other values give a fixed sky. Greyed out in Real sky mode, where star brightness and positions come from the catalogue." />
      <button follows="left|top" height="23" label="Randomize seed" enabled_control="ASStarsProceduralUI" layout="topleft" left="250" name="randomize_stars_seed" top="68" width="155" tool_tip="Procedural only. Picks a new fixed star pattern. Greyed out in Real sky mode, where star brightness and positions come from the catalogue.">
        <button.commit_callback function="ASStars.RandomizeSeed" />
      </button>
    </panel>
  </tab_container>
  <button follows="left|top" height="23" label="Reset all" enabled_control="ASStarsEnabled" layout="topleft" left="250" name="reset_stars_all" top="250" width="155" tool_tip="Restore the default star settings (real sky). Untick Enable AyaneStorm stars for the stock look.">
    <button.commit_callback function="ASStars.ResetDefault" parameter="all" />
  </button>
</panel>
