<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- AyaneStorm Viewer; author: chanayane@firestorm -->
<panel border="false" follows="all" height="282" layout="topleft" left="1" top="1" width="460" name="as_stars_settings">
  <!-- All controls apply live and remain local to this viewer. Defaults: real sky; the master toggle off gives the stock sky. -->
  <!-- Master toggle and star source above the tabs; settings grouped by tab. -->
  <check_box control_name="ASStarsEnabled" follows="left|top" height="16" label="Enable AyaneStorm stars" layout="topleft" left="15" name="stars_enabled" top="10" width="410" tool_tip="Uses the settings below. When off, stars are drawn exactly as in the stock viewer." />
  <text follows="left|top" height="16" layout="topleft" left="15" name="stars_mode_label" top="40" width="190">Star source</text>
  <combo_box control_name="ASStarsMode" enabled_control="ASStarsEnabled" follows="left|top" height="23" layout="topleft" left="205" name="stars_mode" top="34" width="200" tool_tip="Procedural: random stars (stock style). Real sky: actual stars from a catalogue, brightest first, positioned for the latitude below.">
    <combo_box.item label="Procedural" name="procedural" value="0" />
    <combo_box.item label="Real sky" name="real_sky" value="1" />
  </combo_box>
  <tab_container follows="all" height="180" layout="topleft" left="2" name="stars_tabs" tab_position="top" top="64" width="456">
    <panel border="false" follows="all" height="152" label="Stars" layout="topleft" left="0" name="stars_tab_main" top="0" width="456">
      <slider can_edit_text="true" control_name="ASStarsDensity" decimal_digits="3" follows="left|top" height="16" increment="0.001" label="Density" label_width="190" enabled_control="ASStarsEnabled" layout="topleft" left="15" max_val="30.0" min_val="0.0" name="stars_density" show_text="true" text_width="60" top="12" width="390" tool_tip="Star count multiplier. Procedural: 1 matches the stock sky (666 stars). Real sky: the brightest stars are kept; 1 draws 6660 (naked-eye limit), 3 or more all 20000 (down to magnitude 7.25)." />
      <button follows="left|top" height="20" image_overlay="Refresh_Off" enabled_control="ASStarsEnabled" layout="topleft" left="415" name="reset_stars_density" top="10" tool_tip="Reset density to its default value" width="20"><button.commit_callback function="ASStars.ResetDefault" parameter="ASStarsDensity" /></button>
      <slider can_edit_text="true" control_name="ASStarsBrightness" decimal_digits="3" follows="left|top" height="16" increment="0.001" label="Brightness" label_width="190" enabled_control="ASStarsEnabled" layout="topleft" left="15" max_val="4.0" min_val="0.0" name="stars_brightness" show_text="true" text_width="60" top="40" width="390" tool_tip="Multiplies the sky setting's star brightness." />
      <button follows="left|top" height="20" image_overlay="Refresh_Off" enabled_control="ASStarsEnabled" layout="topleft" left="415" name="reset_stars_brightness" top="38" tool_tip="Reset brightness to its default value" width="20"><button.commit_callback function="ASStars.ResetDefault" parameter="ASStarsBrightness" /></button>
      <slider can_edit_text="true" control_name="ASStarsSize" decimal_digits="3" follows="left|top" height="16" increment="0.001" label="Size" label_width="190" enabled_control="ASStarsEnabled" layout="topleft" left="15" max_val="4.0" min_val="0.25" name="stars_size" show_text="true" text_width="60" top="68" width="390" />
      <button follows="left|top" height="20" image_overlay="Refresh_Off" enabled_control="ASStarsEnabled" layout="topleft" left="415" name="reset_stars_size" top="66" tool_tip="Reset size to its default value" width="20"><button.commit_callback function="ASStars.ResetDefault" parameter="ASStarsSize" /></button>
      <slider can_edit_text="true" control_name="ASStarsTwinkle" decimal_digits="3" follows="left|top" height="16" increment="0.001" label="Twinkle" label_width="190" enabled_control="ASStarsEnabled" layout="topleft" left="15" max_val="1.0" min_val="0.0" name="stars_twinkle" show_text="true" text_width="60" top="96" width="390" tool_tip="0 keeps stars steady; 1 is the stock twinkle." />
      <button follows="left|top" height="20" image_overlay="Refresh_Off" enabled_control="ASStarsEnabled" layout="topleft" left="415" name="reset_stars_twinkle" top="94" tool_tip="Reset twinkle to its default value" width="20"><button.commit_callback function="ASStars.ResetDefault" parameter="ASStarsTwinkle" /></button>
    </panel>
    <panel border="false" follows="all" height="152" label="Color" layout="topleft" left="0" name="stars_tab_color" top="0" width="456">
      <slider can_edit_text="true" control_name="ASStarsColorAmount" decimal_digits="3" follows="left|top" height="16" increment="0.001" label="Color realism" label_width="190" enabled_control="ASStarsEnabled" layout="topleft" left="15" max_val="1.0" min_val="0.0" name="stars_color_amount" show_text="true" text_width="60" top="12" width="390" tool_tip="0 keeps the stock star tint; 1 colors each star by its temperature (blue-white to red)." />
      <button follows="left|top" height="20" image_overlay="Refresh_Off" enabled_control="ASStarsEnabled" layout="topleft" left="415" name="reset_stars_color_amount" top="10" tool_tip="Reset color realism to its default value" width="20"><button.commit_callback function="ASStars.ResetDefault" parameter="ASStarsColorAmount" /></button>
      <slider can_edit_text="true" control_name="ASStarsSaturation" decimal_digits="3" follows="left|top" height="16" increment="0.001" label="Color saturation" label_width="190" enabled_control="ASStarsEnabled" layout="topleft" left="15" max_val="3.0" min_val="0.0" name="stars_saturation" show_text="true" text_width="60" top="40" width="390" />
      <button follows="left|top" height="20" image_overlay="Refresh_Off" enabled_control="ASStarsEnabled" layout="topleft" left="415" name="reset_stars_saturation" top="38" tool_tip="Reset color saturation to its default value" width="20"><button.commit_callback function="ASStars.ResetDefault" parameter="ASStarsSaturation" /></button>
      <slider can_edit_text="true" control_name="ASStarsTemperatureBias" decimal_digits="3" follows="left|top" height="16" increment="0.001" label="Temperature (warm/cool)" label_width="190" enabled_control="ASStarsEnabled" layout="topleft" left="15" max_val="1.0" min_val="-1.0" name="stars_temperature_bias" show_text="true" text_width="60" top="68" width="390" tool_tip="Negative values shift stars toward orange and red; positive values toward blue." />
      <button follows="left|top" height="20" image_overlay="Refresh_Off" enabled_control="ASStarsEnabled" layout="topleft" left="415" name="reset_stars_temperature_bias" top="66" tool_tip="Reset temperature to its default value" width="20"><button.commit_callback function="ASStars.ResetDefault" parameter="ASStarsTemperatureBias" /></button>
    </panel>
    <panel border="false" follows="all" height="152" label="Real sky" layout="topleft" left="0" name="stars_tab_real_sky" top="0" width="456">
      <text follows="left|top" height="16" layout="topleft" left="15" name="stars_latitude_preset_label" top="16" width="190">Place</text>
      <combo_box enabled_control="ASStarsRealSkyUI" follows="left|top" height="23" layout="topleft" left="205" max_chars="64" name="stars_latitude_preset" top="10" width="200" tool_tip="Sets Latitude to see the sky as from this place: the 30 largest cities in the world, the largest city of other notable countries, and reference points. Greyed out in Procedural mode: real-sky settings only apply to catalogue stars.">
