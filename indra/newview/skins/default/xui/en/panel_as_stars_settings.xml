<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- AyaneStorm Viewer; author: chanayane@firestorm -->
<panel border="false" follows="all" height="440" layout="topleft" left="1" top="1" width="460" name="as_stars_settings">
  <!-- All controls apply live and remain local to this viewer. Defaults match the stock sky. -->
  <check_box control_name="ASStarsEnabled" follows="left|top" height="16" label="Enable AyaneStorm stars" layout="topleft" left="15" name="stars_enabled" top="10" width="410" tool_tip="Uses the settings below. When off, stars are drawn exactly as in the stock viewer." />
  <text follows="left|top" font="SansSerifSmallBold" height="14" layout="topleft" left="15" name="stars_distribution_label" top="38" width="300">Star field</text>
  <slider can_edit_text="true" control_name="ASStarsDensity" decimal_digits="2" follows="left|top" height="16" increment="0.05" label="Density" label_width="190" enabled_control="ASStarsEnabled" layout="topleft" left="15" max_val="20.0" min_val="0.0" name="stars_density" show_text="true" text_width="50" top="62" width="390" tool_tip="Star count multiplier; 1 matches the stock sky (666 stars)." />
  <button follows="left|top" height="20" image_overlay="Refresh_Off" enabled_control="ASStarsEnabled" layout="topleft" left="415" name="reset_stars_density" top="60" tool_tip="Reset density to its default value" width="20"><button.commit_callback function="ASStars.ResetDefault" parameter="ASStarsDensity" /></button>
  <slider can_edit_text="true" control_name="ASStarsMilkyWay" decimal_digits="2" follows="left|top" height="16" increment="0.01" label="Milky Way concentration" label_width="190" enabled_control="ASStarsEnabled" layout="topleft" left="15" max_val="1.0" min_val="0.0" name="stars_milky_way" show_text="true" text_width="50" top="90" width="390" tool_tip="Adds extra stars in a band across the sky; the background field keeps its density." />
  <button follows="left|top" height="20" image_overlay="Refresh_Off" enabled_control="ASStarsEnabled" layout="topleft" left="415" name="reset_stars_milky_way" top="88" tool_tip="Reset Milky Way concentration to its default value" width="20"><button.commit_callback function="ASStars.ResetDefault" parameter="ASStarsMilkyWay" /></button>
  <slider can_edit_text="true" control_name="ASStarsBrightnessSpread" decimal_digits="2" follows="left|top" height="16" increment="0.05" label="Brightness contrast" label_width="190" enabled_control="ASStarsEnabled" layout="topleft" left="15" max_val="6.0" min_val="0.5" name="stars_brightness_spread" show_text="true" text_width="50" top="118" width="390" tool_tip="Higher values leave fewer bright stars among many faint ones." />
  <button follows="left|top" height="20" image_overlay="Refresh_Off" enabled_control="ASStarsEnabled" layout="topleft" left="415" name="reset_stars_brightness_spread" top="116" tool_tip="Reset brightness contrast to its default value" width="20"><button.commit_callback function="ASStars.ResetDefault" parameter="ASStarsBrightnessSpread" /></button>
  <text follows="left|top" font="SansSerifSmallBold" height="14" layout="topleft" left="15" name="stars_color_label" top="148" width="300">Color</text>
  <slider can_edit_text="true" control_name="ASStarsColorAmount" decimal_digits="2" follows="left|top" height="16" increment="0.01" label="Color realism" label_width="190" enabled_control="ASStarsEnabled" layout="topleft" left="15" max_val="1.0" min_val="0.0" name="stars_color_amount" show_text="true" text_width="50" top="170" width="390" tool_tip="0 keeps the stock star tint; 1 colors each star by its temperature (blue-white to red)." />
  <button follows="left|top" height="20" image_overlay="Refresh_Off" enabled_control="ASStarsEnabled" layout="topleft" left="415" name="reset_stars_color_amount" top="168" tool_tip="Reset color realism to its default value" width="20"><button.commit_callback function="ASStars.ResetDefault" parameter="ASStarsColorAmount" /></button>
  <slider can_edit_text="true" control_name="ASStarsSaturation" decimal_digits="2" follows="left|top" height="16" increment="0.05" label="Color saturation" label_width="190" enabled_control="ASStarsEnabled" layout="topleft" left="15" max_val="3.0" min_val="0.0" name="stars_saturation" show_text="true" text_width="50" top="198" width="390" />
  <button follows="left|top" height="20" image_overlay="Refresh_Off" enabled_control="ASStarsEnabled" layout="topleft" left="415" name="reset_stars_saturation" top="196" tool_tip="Reset color saturation to its default value" width="20"><button.commit_callback function="ASStars.ResetDefault" parameter="ASStarsSaturation" /></button>
  <slider can_edit_text="true" control_name="ASStarsTemperatureBias" decimal_digits="2" follows="left|top" height="16" increment="0.05" label="Temperature (warm/cool)" label_width="190" enabled_control="ASStarsEnabled" layout="topleft" left="15" max_val="1.0" min_val="-1.0" name="stars_temperature_bias" show_text="true" text_width="50" top="226" width="390" tool_tip="Negative values shift stars toward orange and red; positive values toward blue." />
  <button follows="left|top" height="20" image_overlay="Refresh_Off" enabled_control="ASStarsEnabled" layout="topleft" left="415" name="reset_stars_temperature_bias" top="224" tool_tip="Reset temperature to its default value" width="20"><button.commit_callback function="ASStars.ResetDefault" parameter="ASStarsTemperatureBias" /></button>
  <text follows="left|top" font="SansSerifSmallBold" height="14" layout="topleft" left="15" name="stars_appearance_label" top="256" width="300">Appearance</text>
  <slider can_edit_text="true" control_name="ASStarsBrightness" decimal_digits="2" follows="left|top" height="16" increment="0.05" label="Brightness" label_width="190" enabled_control="ASStarsEnabled" layout="topleft" left="15" max_val="4.0" min_val="0.0" name="stars_brightness" show_text="true" text_width="50" top="278" width="390" tool_tip="Multiplies the sky setting's star brightness." />
  <button follows="left|top" height="20" image_overlay="Refresh_Off" enabled_control="ASStarsEnabled" layout="topleft" left="415" name="reset_stars_brightness" top="276" tool_tip="Reset brightness to its default value" width="20"><button.commit_callback function="ASStars.ResetDefault" parameter="ASStarsBrightness" /></button>
  <slider can_edit_text="true" control_name="ASStarsSize" decimal_digits="2" follows="left|top" height="16" increment="0.05" label="Size" label_width="190" enabled_control="ASStarsEnabled" layout="topleft" left="15" max_val="4.0" min_val="0.25" name="stars_size" show_text="true" text_width="50" top="306" width="390" />
  <button follows="left|top" height="20" image_overlay="Refresh_Off" enabled_control="ASStarsEnabled" layout="topleft" left="415" name="reset_stars_size" top="304" tool_tip="Reset size to its default value" width="20"><button.commit_callback function="ASStars.ResetDefault" parameter="ASStarsSize" /></button>
  <slider can_edit_text="true" control_name="ASStarsTwinkle" decimal_digits="2" follows="left|top" height="16" increment="0.05" label="Twinkle" label_width="190" enabled_control="ASStarsEnabled" layout="topleft" left="15" max_val="1.0" min_val="0.0" name="stars_twinkle" show_text="true" text_width="50" top="334" width="390" tool_tip="0 keeps stars steady; 1 is the stock twinkle." />
  <button follows="left|top" height="20" image_overlay="Refresh_Off" enabled_control="ASStarsEnabled" layout="topleft" left="415" name="reset_stars_twinkle" top="332" tool_tip="Reset twinkle to its default value" width="20"><button.commit_callback function="ASStars.ResetDefault" parameter="ASStarsTwinkle" /></button>
  <text follows="left|top" height="16" layout="topleft" left="15" name="stars_seed_label" top="372" width="120">Pattern seed</text>
  <spinner control_name="ASStarsSeed" decimal_digits="0" follows="left|top" height="23" increment="1" label_width="0" enabled_control="ASStarsEnabled" layout="topleft" left="135" max_val="999999" min_val="0" name="stars_seed" top="364" width="100" tool_tip="0 picks a new random sky each time stars are built; other values give a fixed sky." />
  <button follows="left|top" height="23" label="Randomize seed" enabled_control="ASStarsEnabled" layout="topleft" left="250" name="randomize_stars_seed" top="364" width="155">
    <button.commit_callback function="ASStars.RandomizeSeed" />
  </button>
  <button follows="left|top" height="23" label="Reset all" enabled_control="ASStarsEnabled" layout="topleft" left="250" name="reset_stars_all" top="400" width="155" tool_tip="Restore the stock star look">
    <button.commit_callback function="ASStars.ResetDefault" parameter="all" />
  </button>
</panel>
